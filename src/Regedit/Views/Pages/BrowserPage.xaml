<Page
    x:Class="JPSoftworks.Regedit.Views.Pages.BrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:browser="using:JPSoftworks.Regedit.Controls.Browser"
    xmlns:controls="using:JPSoftworks.Regedit.Controls.Omnibox"
    xmlns:shared="using:JPSoftworks.Regedit.Controls.Shared"
    NavigationCacheMode="Enabled">
    <Page.Resources>
        <Style
            x:Key="ToolbarShortcutToggleStyle"
            BasedOn="{StaticResource DefaultToggleButtonStyle}"
            TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        </Style>
        <Style
            x:Key="ToolsMenuPinButtonStyle"
            BasedOn="{StaticResource SubtleButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <ControlTemplate x:Key="PinnableToolsMenuItemTemplate" TargetType="MenuFlyoutItem">
            <Grid
                x:Name="Row"
                Margin="{StaticResource MenuFlyoutItemMargin}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                ColumnDefinitions="*,Auto"
                CornerRadius="{TemplateBinding CornerRadius}">
                <Grid
                    x:Name="ActionContent"
                    Padding="{TemplateBinding Padding}"
                    ColumnDefinitions="28,28,*,Auto">
                    <FontIcon
                        x:Name="CheckGlyph"
                        HorizontalAlignment="Left"
                        FontSize="12"
                        Foreground="{TemplateBinding Foreground}"
                        Glyph="&#xE73E;"
                        Opacity="0" />
                    <Viewbox
                        Grid.Column="1"
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                        <ContentPresenter
                            x:Name="ToolIcon"
                            Content="{TemplateBinding Icon}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Viewbox>
                    <TextBlock
                        x:Name="Label"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{TemplateBinding Foreground}"
                        Text="{TemplateBinding Text}"
                        TextTrimming="{ThemeResource MenuFlyoutItemTextTrimming}" />
                    <TextBlock
                        x:Name="KeyboardAcceleratorTextBlock"
                        Grid.Column="3"
                        Margin="24,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Foreground="{ThemeResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{TemplateBinding KeyboardAcceleratorTextOverride}"
                        Visibility="Collapsed" />
                </Grid>
                <ContentPresenter
                    Grid.Column="1"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Content="{TemplateBinding Tag}" />
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="Row.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" />
                                <Setter Target="Label.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPointerOver}" />
                                <Setter Target="ToolIcon.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPointerOver}" />
                                <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPointerOver}" />
                                <Setter Target="KeyboardAcceleratorTextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="Row.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPressed}" />
                                <Setter Target="Label.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPressed}" />
                                <Setter Target="ToolIcon.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPressed}" />
                                <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPressed}" />
                                <Setter Target="KeyboardAcceleratorTextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Target="Row.Background" Value="{ThemeResource MenuFlyoutItemBackgroundDisabled}" />
                                <Setter Target="Label.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundDisabled}" />
                                <Setter Target="ToolIcon.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundDisabled}" />
                                <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundDisabled}" />
                                <Setter Target="KeyboardAcceleratorTextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="CheckStates">
                        <VisualState x:Name="UncheckedWithIcon" />
                        <VisualState x:Name="CheckedWithIcon">
                            <VisualState.Setters>
                                <Setter Target="CheckGlyph.Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="PaddingSizeStates">
                        <VisualState x:Name="DefaultPadding" />
                        <VisualState x:Name="NarrowPadding">
                            <VisualState.Setters>
                                <Setter Target="ActionContent.Padding" Value="{StaticResource MenuFlyoutItemThemePaddingNarrow}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="KeyboardAcceleratorTextVisibility">
                        <VisualState x:Name="KeyboardAcceleratorTextCollapsed" />
                        <VisualState x:Name="KeyboardAcceleratorTextVisible">
                            <VisualState.Setters>
                                <Setter Target="KeyboardAcceleratorTextBlock.Visibility" Value="Visible" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </ControlTemplate>
        <MenuFlyout x:Key="ListToolbarMenu" Placement="BottomEdgeAlignedLeft">
            <ToggleMenuFlyoutItem IsChecked="{x:Bind Preferences.ShowListToolbar, Mode=TwoWay}" Text="List toolbar" />
        </MenuFlyout>
        <MenuFlyout
            x:Key="RegistryEntryMenu"
            Opening="RegistryEntryMenu_Opening"
            Placement="BottomEdgeAlignedLeft">
            <MenuFlyoutItem
                x:Name="EntryOpenMenu"
                Command="{x:Bind ViewModel.ActivateEntryCommand, Mode=OneWay}"
                Icon="OpenFile"
                KeyboardAcceleratorTextOverride="Enter"
                Text="Open" />
            <MenuFlyoutItem
                x:Name="EntryBinaryMenu"
                Command="{x:Bind ViewModel.EditBinaryCommand, Mode=OneWay}"
                Icon="Edit"
                Text="Modify binary data…" />
            <MenuFlyoutItem
                x:Name="EntryNewTabMenu"
                Click="EntryNewTab_Click"
                Text="Open key in new tab">
                <MenuFlyoutItem.Icon>
                    <IconSourceElement IconSource="{StaticResource OpenInNewTabIcon}" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="EntrySwitchHiveMenu"
                AutomationProperties.AutomationId="EntrySwitchHive"
                Command="{x:Bind ViewModel.SwitchHiveCommand}"
                KeyboardAcceleratorTextOverride="Ctrl+Shift+H"
                Text="Go to HKLM"
                Visibility="Collapsed" />
            <MenuFlyoutSeparator x:Name="EntryOpenSeparator" />
            <MenuFlyoutItem
                x:Name="EntryOpenTargetMenu"
                AutomationProperties.AutomationId="EntryOpenTarget"
                Command="{x:Bind ViewModel.OpenLinkTargetCommand}"
                Text="Open target">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE71B;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="EntryCopyMenu"
                Command="{x:Bind ViewModel.CopyCommand, Mode=OneWay}"
                Icon="Copy"
                KeyboardAcceleratorTextOverride="Ctrl+C"
                Text="Copy" />
            <MenuFlyoutItem
                x:Name="EntryDuplicateMenu"
                AutomationProperties.AutomationId="DuplicateValue"
                Command="{x:Bind ViewModel.DuplicateValueCommand}"
                Icon="Copy"
                Text="Duplicate value…" />
            <MenuFlyoutItem
                x:Name="EntryCopyPathMenu"
                Click="CopyPath_Click"
                KeyboardAcceleratorTextOverride="Ctrl+Shift+C"
                Text="Copy key path">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE62F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSubItem x:Name="EntryCopyPathAsMenu" Text="Copy path as…">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon Glyph="&#xE62F;" />
                </MenuFlyoutSubItem.Icon>
            </MenuFlyoutSubItem>
            <MenuFlyoutItem
                x:Name="EntryWebSearchMenu"
                AutomationProperties.AutomationId="EntryWebSearch"
                Click="EntryWebSearch_Click"
                Text="Search the web">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE774;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator x:Name="EntryCopySeparator" />
            <MenuFlyoutItem
                x:Name="EntryFavoriteMenu"
                Click="EntryFavorite_Click"
                Icon="Favorite"
                KeyboardAcceleratorTextOverride="Ctrl+D"
                Text="Add to favorites…" />
            <MenuFlyoutItem
                x:Name="EntryInspectMenu"
                Command="{x:Bind ViewModel.InspectCommand}"
                Icon="View"
                KeyboardAcceleratorTextOverride="Ctrl+I"
                Text="Inspect value…" />
            <MenuFlyoutItem
                x:Name="EntryRevealMenu"
                Command="{x:Bind ViewModel.RevealFileCommand}"
                Icon="Folder"
                Text="Reveal in File Explorer" />
            <MenuFlyoutItem
                x:Name="EntryWatchMenu"
                Command="{x:Bind ViewModel.WatchValueCommand}"
                Text="Watch value">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7B3;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="EntryExportMenu"
                Command="{x:Bind ViewModel.Branches.ExportCommand}"
                CommandParameter="{x:Bind ViewModel.SelectedEntry.Key, Mode=OneWay}"
                Icon="Save"
                Text="Export…" />
            <MenuFlyoutItem
                x:Name="EntryUsageMenu"
                AutomationProperties.AutomationId="EntryRegistryUsage"
                Click="EntryUsage_Click"
                Text="Registry Usage">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEB05;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="EntryPermissionsMenu"
                Command="{x:Bind ViewModel.Branches.PermissionsCommand}"
                CommandParameter="{x:Bind ViewModel.SelectedEntry.Key, Mode=OneWay}"
                Icon="Permissions"
                Text="Permissions…" />
            <MenuFlyoutSeparator x:Name="EntryToolsSeparator" />
            <MenuFlyoutItem
                x:Name="EntryRenameMenu"
                Command="{x:Bind ViewModel.RenameCommand, Mode=OneWay}"
                Icon="Rename"
                KeyboardAcceleratorTextOverride="F2"
                Text="Rename…" />
            <MenuFlyoutItem
                x:Name="EntryDeleteMenu"
                Command="{x:Bind ViewModel.DeleteCommand, Mode=OneWay}"
                Icon="Delete"
                KeyboardAcceleratorTextOverride="Del"
                Text="Delete" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Command="{x:Bind ViewModel.UndoCommand}"
                Icon="Undo"
                KeyboardAcceleratorTextOverride="Ctrl+Z"
                Text="{x:Bind ViewModel.UndoLabel, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.UndoHelp, Mode=OneWay}" />
            <MenuFlyoutItem
                Command="{x:Bind ViewModel.RedoCommand}"
                Icon="Redo"
                KeyboardAcceleratorTextOverride="Ctrl+Y"
                Text="{x:Bind ViewModel.RedoLabel, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.RedoHelp, Mode=OneWay}" />
        </MenuFlyout>
        <MenuFlyout
            x:Key="RegistryTreeMenu"
            Opening="RegistryTreeMenu_Opening"
            Placement="BottomEdgeAlignedLeft">
            <MenuFlyoutItem Click="TreeNewTab_Click" Text="Open in new tab">
                <MenuFlyoutItem.Icon>
                    <IconSourceElement IconSource="{StaticResource OpenInNewTabIcon}" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="TreePowerShellMenu"
                AutomationProperties.AutomationId="TreeOpenPowerShell"
                Click="TreeOpenPowerShell_Click"
                Text="Open PowerShell here"
                Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE756;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="TreeUseKeyInPowerShellMenu"
                AutomationProperties.AutomationId="TreeUseKeyInPowerShell"
                Click="TreeUseKeyInPowerShell_Click"
                Text="Use this key in PowerShell"
                Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74B;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="TreeSwitchHiveMenu"
                AutomationProperties.AutomationId="TreeSwitchHive"
                Command="{x:Bind ViewModel.SwitchHiveCommand}"
                KeyboardAcceleratorTextOverride="Ctrl+Shift+H"
                Text="Go to HKLM"
                Visibility="Collapsed" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="TreeCopyPath_Click"
                KeyboardAcceleratorTextOverride="Ctrl+Shift+C"
                Text="Copy key path">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE62F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSubItem x:Name="TreeCopyPathAsMenu" Text="Copy path as…">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon Glyph="&#xE62F;" />
                </MenuFlyoutSubItem.Icon>
            </MenuFlyoutSubItem>
            <MenuFlyoutItem
                x:Name="TreeWebSearchMenu"
                AutomationProperties.AutomationId="TreeWebSearch"
                Click="TreeWebSearch_Click"
                Text="Search the web">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE774;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                x:Name="TreeFavoriteMenu"
                Click="TreeFavorite_Click"
                Icon="Favorite"
                KeyboardAcceleratorTextOverride="Ctrl+D"
                Text="Add to favorites…" />
            <MenuFlyoutItem
                x:Name="TreeExportMenu"
                Command="{x:Bind ViewModel.Branches.ExportCommand}"
                Icon="Save"
                Text="Export…" />
            <MenuFlyoutItem
                x:Name="TreeUsageMenu"
                AutomationProperties.AutomationId="TreeRegistryUsage"
                Click="TreeUsage_Click"
                Text="Registry Usage">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEB05;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                x:Name="TreePermissionsMenu"
                Command="{x:Bind ViewModel.Branches.PermissionsCommand}"
                Icon="Permissions"
                Text="Permissions…" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                x:Name="TreeRenameMenu"
                Command="{x:Bind ViewModel.RenameTreeKeyCommand}"
                Icon="Rename"
                KeyboardAcceleratorTextOverride="F2"
                Text="Rename…" />
            <MenuFlyoutItem
                x:Name="TreeDeleteMenu"
                Command="{x:Bind ViewModel.DeleteTreeKeyCommand}"
                Icon="Delete"
                KeyboardAcceleratorTextOverride="Del"
                Text="Delete" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Command="{x:Bind ViewModel.UndoCommand}"
                Icon="Undo"
                KeyboardAcceleratorTextOverride="Ctrl+Z"
                Text="{x:Bind ViewModel.UndoLabel, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.UndoHelp, Mode=OneWay}" />
            <MenuFlyoutItem
                Command="{x:Bind ViewModel.RedoCommand}"
                Icon="Redo"
                KeyboardAcceleratorTextOverride="Ctrl+Y"
                Text="{x:Bind ViewModel.RedoLabel, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.RedoHelp, Mode=OneWay}" />
        </MenuFlyout>
        <MenuFlyout
            x:Key="RegistryListMenu"
            Opening="RegistryListMenu_Opening"
            Placement="BottomEdgeAlignedLeft">
            <MenuFlyoutSubItem
                Icon="Add"
                IsEnabled="{x:Bind ViewModel.IsKeyLocation, Mode=OneWay}"
                Text="New"
                ToolTipService.ToolTip="Create a key or value (Ctrl+N)">
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CreateKeyCommand, Mode=OneWay}"
                    Icon="Folder"
                    Text="Key" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CreateValueCommand, Mode=OneWay}"
                    CommandParameter="1"
                    Text="String value" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CreateValueCommand, Mode=OneWay}"
                    CommandParameter="3"
                    Text="Binary value" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CreateValueCommand, Mode=OneWay}"
                    CommandParameter="4"
                    Text="DWORD (32-bit) value" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CreateValueCommand, Mode=OneWay}"
                    CommandParameter="11"
                    Text="QWORD (64-bit) value" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CreateValueCommand, Mode=OneWay}"
                    CommandParameter="7"
                    Text="Multi-string value" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CreateValueCommand, Mode=OneWay}"
                    CommandParameter="2"
                    Text="Expandable string value" />
            </MenuFlyoutSubItem>
            <MenuFlyoutItem
                x:Name="ListPasteMenu"
                Command="{x:Bind ViewModel.PasteCommand, Mode=OneWay}"
                Icon="Paste"
                KeyboardAcceleratorTextOverride="Ctrl+V"
                Text="Paste" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Command="{x:Bind ViewModel.RefreshCommand}"
                Icon="Refresh"
                KeyboardAcceleratorTextOverride="F5"
                Text="Refresh" />
            <MenuFlyoutItem
                Click="CopyCurrentPath_Click"
                KeyboardAcceleratorTextOverride="Ctrl+Shift+C"
                Text="Copy current key path">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE62F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSubItem x:Name="ListCopyPathAsMenu" Text="Copy path as…">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon Glyph="&#xE62F;" />
                </MenuFlyoutSubItem.Icon>
            </MenuFlyoutSubItem>
            <MenuFlyoutItem
                x:Name="ListSwitchHiveMenu"
                AutomationProperties.AutomationId="ListSwitchHive"
                Command="{x:Bind ViewModel.SwitchHiveCommand}"
                KeyboardAcceleratorTextOverride="Ctrl+Shift+H"
                Text="Go to HKLM"
                Visibility="Collapsed" />
            <MenuFlyoutItem
                Click="CurrentWebSearch_Click"
                IsEnabled="{x:Bind ViewModel.IsKeyLocation, Mode=OneWay}"
                Text="Search the web">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE774;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Command="{x:Bind ViewModel.UndoCommand}"
                Icon="Undo"
                KeyboardAcceleratorTextOverride="Ctrl+Z"
                Text="{x:Bind ViewModel.UndoLabel, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.UndoHelp, Mode=OneWay}" />
            <MenuFlyoutItem
                Command="{x:Bind ViewModel.RedoCommand}"
                Icon="Redo"
                KeyboardAcceleratorTextOverride="Ctrl+Y"
                Text="{x:Bind ViewModel.RedoLabel, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.RedoHelp, Mode=OneWay}" />
            <MenuFlyoutSeparator />
            <MenuFlyoutSubItem Text="View">
                <ToggleMenuFlyoutItem IsChecked="{x:Bind Preferences.ShowKeysInList, Mode=TwoWay}" Text="Show keys in list" />
                <ToggleMenuFlyoutItem
                    IsChecked="{x:Bind Preferences.ShowParentKeyInList, Mode=TwoWay}"
                    IsEnabled="{x:Bind Preferences.ShowKeysInList, Mode=OneWay}"
                    Text="Show parent key .." />
                <ToggleMenuFlyoutItem IsChecked="{x:Bind Preferences.ShowValuePreview, Mode=TwoWay}" Text="Value preview" />
                <MenuFlyoutItem Click="ListSpacing_Click" Text="List spacing…" />
                <MenuFlyoutSeparator />
                <ToggleMenuFlyoutItem
                    x:Name="ListNavigationPaneMenu"
                    Click="TogglePane_Click"
                    Text="Navigation pane" />
                <ToggleMenuFlyoutItem IsChecked="{x:Bind Preferences.ShowListToolbar, Mode=TwoWay}" Text="List toolbar" />
                <ToggleMenuFlyoutItem IsChecked="{x:Bind Preferences.AutoSyncTree, Mode=TwoWay}" Text="Automatically sync tree" />
                <MenuFlyoutItem
                    Click="SyncTree_Click"
                    Icon="Sync"
                    KeyboardAcceleratorTextOverride="Alt+Shift+L"
                    Text="Sync tree to current key" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Registry view">
                    <ToggleMenuFlyoutItem
                        x:Name="ListRegistry64Menu"
                        Command="{x:Bind ViewModel.Use64BitViewCommand}"
                        Text="64-bit registry" />
                    <ToggleMenuFlyoutItem
                        x:Name="ListRegistry32Menu"
                        Command="{x:Bind ViewModel.Use32BitViewCommand}"
                        Text="32-bit registry" />
                </MenuFlyoutSubItem>
            </MenuFlyoutSubItem>
        </MenuFlyout>
        <Style
            x:Key="FavoritesBarButtonStyle"
            BasedOn="{StaticResource SubtleButtonStyle}"
            TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>
    <Grid
        x:Name="LayoutRoot"
        Loaded="Page_Loaded"
        PreviewKeyDown="Browser_PreviewKeyDown"
        SizeChanged="Page_SizeChanged"
        Style="{StaticResource TabSurfaceStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="PathRow"
            Padding="8,6"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition
                    x:Name="AddressColumn"
                    Width="3*"
                    MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition
                    x:Name="SearchColumn"
                    Width="*"
                    MinWidth="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                x:Name="NavigationButtons"
                Margin="0,0,8,0"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="BackButton"
                    AccessKey="B"
                    AutomationProperties.Name="Back"
                    Command="{x:Bind ViewModel.BackCommand}"
                    Style="{StaticResource NavigationButton}"
                    ToolTipService.ToolTip="Back (Backspace in the list, Alt+Left or mouse Back button). Right-click for history.">
                    <Button.ContextFlyout>
                        <MenuFlyout Opening="HistoryMenu_Opening" Placement="BottomEdgeAlignedLeft" />
                    </Button.ContextFlyout>
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <Button
                    x:Name="ForwardButton"
                    AccessKey="O"
                    AutomationProperties.Name="Forward"
                    Command="{x:Bind ViewModel.ForwardCommand}"
                    Style="{StaticResource NavigationButton}"
                    ToolTipService.ToolTip="Forward (Alt+Right or mouse Forward button). Right-click for history.">
                    <Button.ContextFlyout>
                        <MenuFlyout Opening="HistoryMenu_Opening" Placement="BottomEdgeAlignedLeft" />
                    </Button.ContextFlyout>
                    <FontIcon FontSize="14" Glyph="&#xE72A;" />
                </Button>
                <Button
                    x:Name="UpButton"
                    AccessKey="U"
                    AutomationProperties.Name="Up"
                    Command="{x:Bind ViewModel.UpCommand}"
                    Style="{StaticResource NavigationButton}"
                    ToolTipService.ToolTip="Up (Alt+Up)">
                    <FontIcon FontSize="14" Glyph="&#xE74A;" />
                </Button>
                <Button
                    x:Name="RefreshButton"
                    AccessKey="R"
                    AutomationProperties.Name="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource NavigationButton}"
                    ToolTipService.ToolTip="Refresh (F5)">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
            <controls:Omnibox
                x:Name="AddressBar"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="Registry omnibox"
                IsRootSelectorVisible="False"
                NavigationRequested="Address_NavigationRequested">
                <controls:Omnibox.TrailingContent>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            x:Name="Registry32Indicator"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="32-bit registry view"
                            Text="32-bit"
                            Visibility="{x:Bind ViewModel.Is32Bit, Mode=OneWay}" />
                        <Button
                            x:Name="FavoriteButton"
                            Height="32"
                            VerticalAlignment="Center"
                            AccessKey="K"
                            AutomationProperties.Name="{x:Bind ViewModel.FavoriteAction, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                            Style="{StaticResource NavigationButton}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.FavoriteHelp, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.FavoriteGlyph, Mode=OneWay}" />
                        </Button>
                    </StackPanel>
                </controls:Omnibox.TrailingContent>
            </controls:Omnibox>
            <shared:ResizeThumb
                x:Name="SearchSplitter"
                Grid.Column="2"
                Width="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.AutomationId="SearchSplitter"
                AutomationProperties.Name="Resize omnibox and search box"
                PreviewKeyDown="Splitter_KeyDown"
                ToolTipService.ToolTip="Resize omnibox and search box" />
            <Grid
                x:Name="SearchArea"
                Grid.Column="3"
