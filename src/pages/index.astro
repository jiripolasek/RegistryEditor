---
import '../styles/global.css';

const repo = 'https://github.com/jiripolasek/RegistryEditor';
const guide = `${repo}/blob/master/docs/user/Guide.md`;
const features = [
  { number: '01', title: 'More room to explore', description: 'Keep locations side by side with tabs, then pick up where you left off with favorites and workspaces.', label: 'Tabs & workspaces' },
  { number: '02', title: 'Find the value that matters', description: 'Search across keys and values, filter by type, and keep your results close while you investigate.', label: 'Search & discovery' },
  { number: '03', title: 'See what changed', description: 'Compare branch snapshots, follow live changes, and review your edits in the change journal.', label: 'Snapshots & journal' },
];
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A modern Windows registry editor. Explore with tabs, search with context, and understand changes in a native Fluent interface." />
    <meta name="theme-color" content="#f5f5f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={`${base}/logo.svg`} />
    <title>Modern Registry Editor | A clearer view of your registry</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-content">
        <a class="brand" href={`${base}/`} aria-label="Modern Registry Editor home">
          <img src={`${base}/logo.svg`} width="32" height="32" alt="" />
          <span>Registry Editor</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="#features">Features</a>
          <a href={guide}>Documentation</a>
          <a class="source-link" href={repo}>GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Native Windows app · Open source</p>
          <h1 id="hero-title">A clearer view<br />of your <span>registry.</span></h1>
          <p class="hero-description">A familiar place to explore. A better way to investigate. Meet a modern registry editor built for the way you work.</p>
          <div class="actions">
            <a class="button primary" href={`${repo}#development`}>Build from source <span aria-hidden="true">↗</span></a>
            <a class="button secondary" href={guide}>Read the guide <span aria-hidden="true">→</span></a>
          </div>
          <p class="availability">For Windows 10 & 11 <span aria-hidden="true">·</span> Currently available as a source build</p>
        </div>

        <figure class="app-preview" aria-label="Illustrative Registry Editor interface">
          <div class="window-title">
            <div><img src={`${base}/logo.svg`} width="19" height="19" alt="" /><span>Registry Editor</span></div>
            <span class="window-controls" aria-hidden="true">&#x2212; &nbsp; &#x25A1; &nbsp; &#x00D7;</span>
          </div>
          <div class="tab-strip" aria-hidden="true"><span class="active-tab">▱ &nbsp; Explorer &nbsp; <span>×</span></span><span>＋</span></div>
          <div class="address-bar"><span aria-hidden="true">← &nbsp; → &nbsp; ↑</span><span class="address">Computer <span aria-hidden="true">›</span> HKEY_CURRENT_USER <span aria-hidden="true">›</span> Software</span></div>
          <div class="registry-content">
            <div class="registry-tree" aria-hidden="true">
              <span>⌄ &nbsp; Computer</span>
              <span class="tree-indent">› &nbsp; HKEY_CLASSES_ROOT</span>
              <span class="tree-indent">⌄ &nbsp; HKEY_CURRENT_USER</span>
              <span class="tree-child">› &nbsp; Control Panel</span>
              <span class="tree-child">› &nbsp; Environment</span>
              <span class="tree-child selected">⌄ &nbsp; Software</span>
              <span class="tree-grandchild">› &nbsp; Microsoft</span>
              <span class="tree-grandchild">› &nbsp; Classes</span>
              <span class="tree-indent">› &nbsp; HKEY_LOCAL_MACHINE</span>
              <span class="tree-indent">› &nbsp; HKEY_USERS</span>
            </div>
            <div class="registry-values">
              <div class="list-caption">Software <span>3 items</span></div>
              <table>
                <caption class="visually-hidden">Illustrative registry values</caption>
                <thead><tr><th scope="col">Name</th><th scope="col">Type</th><th scope="col">Data</th></tr></thead>
                <tbody>
                  <tr><td><span class="value-icon" aria-hidden="true">ab</span> (Default)</td><td>REG_SZ</td><td>(value not set)</td></tr>
                  <tr><td><span class="folder-icon" aria-hidden="true">▱</span> Classes</td><td>Key</td><td></td></tr>
                  <tr><td><span class="folder-icon" aria-hidden="true">▱</span> Microsoft</td><td>Key</td><td></td></tr>
                </tbody>
              </table>
              <div class="preview-panel"><span class="panel-title">Change journal</span><span class="empty-journal">Your changes, in context.</span><span class="journal-detail">Review recorded edits as you work.</span></div>
            </div>
          </div>
          <div class="window-status"><span>HKEY_CURRENT_USER\Software</span><span>64-bit view</span></div>
          <figcaption>Designed for Windows. Built around your workflow. <span>Interface illustration</span></figcaption>
        </figure>
      </section>

      <section class="features container" id="features" aria-labelledby="features-title">
        <div class="section-heading"><p class="eyebrow">Familiar foundations. Thoughtful tools.</p><h2 id="features-title">Go beyond a single window.</h2><p>Everything you need to navigate, inspect, and understand the Windows registry.</p></div>
        <div class="feature-grid">
          {features.map((feature) => (
            <article class="feature-card">
              <span class="feature-number" aria-hidden="true">{feature.number}</span>
              <p class="feature-label">{feature.label}</p>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="getting-started container" aria-labelledby="start-title">
        <div><p class="eyebrow">Make yourself at home</p><h2 id="start-title">Familiar by design.<br />Open by nature.</h2><p>A native Fluent interface with light and dark appearance. Open source, so you can explore the code as easily as your registry.</p><a class="text-link" href={repo}>Explore the project <span aria-hidden="true">→</span></a></div>
        <div class="start-card"><span class="small-label">Getting started</span><h3>Start with the source.</h3><p>There’s no installer yet. The repository includes build instructions and a guide to your first session.</p><a class="button primary" href={`${repo}#development`}>View build instructions <span aria-hidden="true">↗</span></a><p class="safety-note">Registry edits apply immediately. Back up important keys before making changes.</p></div>
      </section>
    </main>

    <footer class="container site-footer"><span>Modern Registry Editor</span><span>By <a href="https://jiripolasek.com">Jiří Polášek</a></span><a href={`${repo}/blob/master/LICENSE.txt`}>Apache 2.0 license</a></footer>
  </body>
</html>
