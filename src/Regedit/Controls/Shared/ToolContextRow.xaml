<UserControl
    x:Class="JPSoftworks.Regedit.Controls.Shared.ToolContextRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="0,4,0,8"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1">
        <StackPanel Spacing="4">
            <ContentPresenter HorizontalContentAlignment="Stretch" Content="{x:Bind PrimaryContent, Mode=OneWay}" />
            <ContentPresenter
                HorizontalContentAlignment="Stretch"
                Content="{x:Bind SecondaryContent, Mode=OneWay}"
                Visibility="{x:Bind ContentVisibility(SecondaryContent), Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
