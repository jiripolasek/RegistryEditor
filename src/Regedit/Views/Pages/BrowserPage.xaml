                PreviewKeyDown="Splitter_KeyDown" />
            <Border
                x:Name="Workspace"
                Grid.Column="2"
                Margin="0"
                Background="{ThemeResource WorkspaceBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
