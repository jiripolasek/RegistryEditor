                                    <shared:CommandIcon Symbol="Undo" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="RedoButton"
                                AutomationProperties.AutomationId="RedoButton"
                                AutomationProperties.HelpText="{x:Bind ViewModel.RedoHelp, Mode=OneWay}"
