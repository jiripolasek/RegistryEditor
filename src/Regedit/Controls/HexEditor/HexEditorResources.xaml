<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hex="using:JPSoftworks.Controls">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="HexEditorHeaderBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="HexEditorHeaderForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="HexEditorHeaderDividerBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="HexEditorColumnBandBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="HexEditorColumnBandForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="HexEditorHoverBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="HexEditorHoverStrokeBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="HexEditorBackgroundBrush" ResourceKey="TextControlBackground" />
            <StaticResource x:Key="HexEditorForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="HexEditorOffsetBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="HexEditorSelectionBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="HexEditorSelectionForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="HexEditorInactiveSelectionBackgroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="HexEditorInactiveSelectionBorderBrush" ResourceKey="HexEditorInactiveSelectionBackgroundBrush" />
            <StaticResource x:Key="HexEditorInactiveSelectionForegroundBrush" ResourceKey="HexEditorForegroundBrush" />
            <StaticResource x:Key="HexEditorFocusBrush" ResourceKey="FocusStrokeColorOuterBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="HexEditorHeaderBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="HexEditorHeaderForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="HexEditorHeaderDividerBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="HexEditorColumnBandBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="HexEditorColumnBandForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="HexEditorHoverBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="HexEditorHoverStrokeBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="HexEditorBackgroundBrush" ResourceKey="TextControlBackground" />
            <StaticResource x:Key="HexEditorForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="HexEditorOffsetBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="HexEditorSelectionBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="HexEditorSelectionForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="HexEditorInactiveSelectionBackgroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="HexEditorInactiveSelectionBorderBrush" ResourceKey="HexEditorInactiveSelectionBackgroundBrush" />
            <StaticResource x:Key="HexEditorInactiveSelectionForegroundBrush" ResourceKey="HexEditorForegroundBrush" />
            <StaticResource x:Key="HexEditorFocusBrush" ResourceKey="FocusStrokeColorOuterBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="HexEditorHeaderBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="HexEditorHeaderForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="HexEditorHeaderDividerBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <SolidColorBrush x:Key="HexEditorColumnBandBrush" Color="Transparent" />
            <StaticResource x:Key="HexEditorColumnBandForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <SolidColorBrush x:Key="HexEditorHoverBackgroundBrush" Color="Transparent" />
            <StaticResource x:Key="HexEditorHoverStrokeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="HexEditorBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="HexEditorForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="HexEditorOffsetBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="HexEditorSelectionBackgroundBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="HexEditorSelectionForegroundBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="HexEditorInactiveSelectionBackgroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="HexEditorInactiveSelectionBorderBrush" ResourceKey="HexEditorInactiveSelectionBackgroundBrush" />
            <StaticResource x:Key="HexEditorInactiveSelectionForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="HexEditorFocusBrush" ResourceKey="SystemColorHighlightColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <FontFamily x:Key="HexEditorFontFamily">Consolas</FontFamily>
    <x:Double x:Key="HexEditorFontSize">14</x:Double>
    <Thickness x:Key="HexEditorPadding">10,3</Thickness>
    <Style x:Key="PlainHexEditorStyle" TargetType="hex:HexEditor">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource HexEditorForegroundBrush}" />
        <Setter Property="FontFamily" Value="{ThemeResource HexEditorFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource HexEditorFontSize}" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Padding" Value="{ThemeResource HexEditorPadding}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource HexEditorFocusBrush}" />
        <Setter Property="ColumnBandBrush" Value="{ThemeResource HexEditorColumnBandBrush}" />
        <Setter Property="ColumnBandForeground" Value="{ThemeResource HexEditorColumnBandForegroundBrush}" />
    </Style>
    <Style x:Key="DefaultHexEditorStyle" BasedOn="{StaticResource PlainHexEditorStyle}" TargetType="hex:HexEditor">
        <Setter Property="Background" Value="{ThemeResource HexEditorBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TextControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource TextControlBorderThemeThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="{ThemeResource IsApplicationFocusVisualKindReveal}" />
    </Style>
    <Style BasedOn="{StaticResource DefaultHexEditorStyle}" TargetType="hex:HexEditor" />
</ResourceDictionary>
