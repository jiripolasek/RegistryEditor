<shell:SecondaryWindow
    x:Class="JPSoftworks.Regedit.Views.Files.RegistryFileWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:files="using:JPSoftworks.Regedit.Views.Files"
    xmlns:shell="using:JPSoftworks.Regedit.Views.Shell"
    Title="Registry file preview">
    <Grid Style="{StaticResource TabSurfaceStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar
            x:Name="WindowTitleBar"
            Title="Open a .reg file"
            AutomationProperties.AutomationId="RegFileTitleBar"
            Subtitle="Registry file preview">
            <TitleBar.IconSource>
                <BitmapIconSource ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Square44x44Logo.scale-200.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <files:RegistryFilePreview x:Name="Preview" Grid.Row="1" />
    </Grid>
</shell:SecondaryWindow>
