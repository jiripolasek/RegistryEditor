                            x:Name="ValueInspectorPane"
                            Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1,1,0,1"
                            Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid
                                    x:Name="ValueInspectorHeader"
                                    Padding="12,8"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="Value inspector" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        AutomationProperties.AutomationId="CloseValueInspector"
                                        AutomationProperties.Name="Close value inspector"
                                        Click="CloseValueInspector_Click"
                                        Style="{StaticResource SubtleButtonStyle}">
                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                                <ScrollViewer
                                    x:Name="ValueInspectorScroll"
                                    Grid.Row="1"
                                    Padding="16,16,8,16"
                                    AutomationProperties.Name="Value inspector"
                                    VerticalScrollBarVisibility="Auto">
                                    <ContentControl
                                        x:Name="ValueInspectorContent"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.AutomationId="ValueInspectorContent"
                                        IsEnabled="{x:Bind ViewModel.IsPreviewCurrent, Mode=OneWay}" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <shared:ToolPaneSplitter x:Name="ValueInspectorSplitter" />
                    </Grid>
                    <Grid
                        x:Name="StatusBar"
                        Grid.Row="3"
                        Padding="8,2"
                        Background="Transparent"
                        ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="8,0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="BrowserStatusText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="RegistryViewStatus"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="RegistryViewStatus"
                            Content="{x:Bind RegistryViewLabel(ViewModel.Is32Bit), Mode=OneWay}"
                            Style="{StaticResource StatusButtonStyle}"
                            ToolTipService.ToolTip="Switch registry view">
                            <Button.Flyout>
                                <MenuFlyout Opening="RegistryViewMenu_Opening" Placement="BottomEdgeAlignedLeft">
                                    <ToggleMenuFlyoutItem
                                        x:Name="StatusRegistry64Menu"
                                        Command="{x:Bind ViewModel.Use64BitViewCommand}"
                                        Text="64-bit registry" />
                                    <ToggleMenuFlyoutItem
                                        x:Name="StatusRegistry32Menu"
                                        Command="{x:Bind ViewModel.Use32BitViewCommand}"
                                        Text="32-bit registry" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            x:Name="AccessStatus"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="AccessStatus"
                            Content="Standard access"
                            Style="{StaticResource StatusButtonStyle}"
                            ToolTipService.ToolTip="Open this location in the other access mode">
                            <Button.Flyout>
                                <Flyout x:Name="AccessModeFlyout" Placement="BottomEdgeAlignedLeft">
                                    <StackPanel MaxWidth="300" Spacing="12">
                                        <TextBlock x:Name="AccessModePrompt" TextWrapping="Wrap" />
                                        <Button
                                            x:Name="AccessModeLaunchButton"
                                            AutomationProperties.AutomationId="AccessModeLaunchButton"
                                            Click="AccessModeLaunch_Click" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            x:Name="ConnectionStatus"
                            Grid.Column="3"
                            AutomationProperties.AutomationId="ConnectionStatus"
                            Command="{x:Bind _window.RegistryMenu.ConnectCommand}"
                            Content="{x:Bind ViewModel.Location.Machine, Mode=OneWay, TargetNullValue='This computer'}"
                            Style="{StaticResource StatusButtonStyle}"
                            ToolTipService.ToolTip="Connect to a network registry" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SearchFocusStates">
                <VisualState x:Name="SearchUnfocused" />
                <VisualState x:Name="SearchFocused">
                    <VisualState.Setters>
                        <Setter Target="SearchFrame.Background" Value="{ThemeResource TextControlBackgroundFocused}" />
                        <Setter Target="SearchFrame.BorderThickness" Value="0,0,0,2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
