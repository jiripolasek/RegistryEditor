<UserControl
    x:Class="JPSoftworks.Regedit.Dialogs.RegistryValueEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="using:JPSoftworks.Regedit.Controls.Shared">
    <UserControl.Resources>
        <Style x:Key="SingleLineDataEditor" TargetType="TextBox" />
        <Style x:Key="TextDataEditor" TargetType="TextBox">
            <Setter Property="MinHeight" Value="120" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!--  Monospaced data, but keep the header in the UI font.  -->
        <DataTemplate x:Key="UiFontHeaderTemplate">
            <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="{Binding}" />
        </DataTemplate>
        <Style x:Key="NumericDataEditor" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="HeaderTemplate" Value="{StaticResource UiFontHeaderTemplate}" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="20">
        <TextBox
            x:Name="NameBox"
            Header="Value name"
            PlaceholderText="(Default)"
            Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Visibility="{x:Bind ViewModel.IsCreating}" />
        <InfoBar
            Title="Opened in binary editor"
            AutomationProperties.AutomationId="ValueRawFallbackNotice"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasRawFallback}"
            Message="{x:Bind ViewModel.RawFallbackMessage}"
            Severity="Warning"
            Visibility="{x:Bind ViewModel.HasRawFallback}" />
        <!--  Realized from code only for raw values, so other editors don't host a hidden hex viewer.  -->
        <StackPanel
            x:Name="RawPanel"
            x:Load="False"
            Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.DataHelp, Mode=OneWay}" />
            <shared:HexView
                x:Name="ByteEditor"
                Height="188"
                AutomationProperties.AutomationId="ValueHexPreview"
                AutomationProperties.Name="Bytes"
                Bytes="{x:Bind ViewModel.PreviewBytes, Mode=OneWay}"
                BytesEdited="HexView_BytesEdited"
                IsReadOnly="False" />
        </StackPanel>
        <StackPanel
            x:Name="DataPanel"
            x:Load="False"
            Spacing="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  Reserve room for the focused bottom stroke in the text host.  -->
                <TextBox
                    x:Name="DataBox"
                    MaxHeight="300"
                    VerticalAlignment="Top"
                    AcceptsReturn="{x:Bind ViewModel.IsMultiline, Mode=OneWay}"
                    AutomationProperties.AutomationId="ValueDataEditor"
                    AutomationProperties.HelpText="{x:Bind ViewModel.DataHelp, Mode=OneWay}"
                    BorderThickness="1,1,1,2"
                    Header="Value data"
                    Paste="DataBox_Paste"
                    Style="{x:Bind GetDataEditorStyle(ViewModel.IsMultiline), Mode=OneWay}"
                    Text="{x:Bind ViewModel.Data, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <RadioButtons
                    x:Name="BaseButtons"
                    Grid.Column="1"
                    Margin="24,0,0,0"
                    Header="Base"
                    SelectedIndex="{x:Bind ViewModel.BaseIndex}"
                    SelectionChanged="Base_SelectionChanged"
                    Visibility="{x:Bind ViewModel.IsNumeric}">
                    <RadioButton AutomationProperties.AutomationId="HexadecimalBaseOption" Content="Hexadecimal" />
                    <RadioButton AutomationProperties.AutomationId="DecimalBaseOption" Content="Decimal" />
                </RadioButtons>
            </Grid>
            <CheckBox
                AutomationProperties.AutomationId="AllowValueLineBreaks"
                AutomationProperties.HelpText="Remove existing line breaks before turning this off."
                Content="Allow line breaks"
                IsChecked="{x:Bind ViewModel.IsMultiline, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.CanToggleMultiline, Mode=OneWay}"
                ToolTipService.ToolTip="Remove existing line breaks before turning this off."
                Visibility="{x:Bind ViewModel.IsString}" />
        </StackPanel>
        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsNumeric}">
            <TextBlock
                AutomationProperties.AutomationId="ValueDataHelp"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.DataHelp, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                AutomationProperties.AutomationId="ApplyValueDataCorrection"
                Command="{x:Bind ViewModel.ApplyDataCorrectionCommand}"
                Content="Apply conversion"
                Visibility="{x:Bind ViewModel.CanApplyDataCorrection, Mode=OneWay}" />
        </StackPanel>
        <TextBlock
            MaxWidth="420"
            Text="Enter one string per line. Empty lines are not supported."
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsMultiString}" />
    </StackPanel>
</UserControl>
