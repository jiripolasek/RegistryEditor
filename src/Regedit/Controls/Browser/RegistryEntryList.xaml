<UserControl
    x:Class="JPSoftworks.Regedit.Controls.Browser.RegistryEntryList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lists="using:JPSoftworks.Regedit.Controls.Lists"
    xmlns:models="using:JPSoftworks.Regedit.Models.Registry"
    xmlns:resources="using:JPSoftworks.Regedit.Resources">
    <UserControl.Resources>
        <DataTemplate
            x:Key="IconCell"
            x:DataType="models:RegistryEntry"
            x:DefaultBindMode="OneWay">
            <Grid VerticalAlignment="Center">
                <FontIcon
                    FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    FontSize="16"
                    Glyph="{x:Bind Glyph}"
                    Visibility="{x:Bind IsParent}" />
                <FontIcon
                    FontSize="16"
                    Glyph="{x:Bind Glyph}"
                    Style="{ThemeResource RegistryNavigationIconStyle}"
                    Visibility="{x:Bind IsKey}" />
                <FontIcon
                    FontFamily="{x:Bind IconFontFamily}"
                    FontSize="16"
                    Glyph="{x:Bind Glyph}"
                    Style="{ThemeResource RegistryStringIconStyle}"
                    Visibility="{x:Bind HasStringIcon}" />
                <FontIcon
                    FontSize="16"
                    Glyph="{x:Bind Glyph}"
                    Style="{ThemeResource RegistryLinkIconStyle}"
                    Visibility="{x:Bind HasLinkIcon}" />
                <IconSourceElement
                    Width="16"
                    Height="16"
                    IconSource="{x:Bind resources:ToolRowResources.BinaryIcon}"
                    Style="{ThemeResource RegistryDataIconStyle}"
                    Visibility="{x:Bind HasBinaryIcon}" />
                <FontIcon
                    FontFamily="{x:Bind IconFontFamily}"
                    FontSize="16"
                    Glyph="{x:Bind Glyph}"
                    Style="{ThemeResource RegistryDataIconStyle}"
                    Visibility="{x:Bind HasDataIcon}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="NameCell" x:DataType="models:RegistryEntry">
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind NamePreview}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind NamePreview}" />
        </DataTemplate>
        <DataTemplate x:Key="TypeCell" x:DataType="models:RegistryEntry">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Type, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="DataCell" x:DataType="models:RegistryEntry">
            <TextBlock
                VerticalAlignment="Center"
                DataContextChanged="DataCell_DataContextChanged"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind DataPreview, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind DataPreview, Mode=OneWay}" />
        </DataTemplate>
        <DataTemplate x:Key="LastWriteCell" x:DataType="models:RegistryEntry">
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.HelpText="{x:Bind LastWriteHelp, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind LastWriteText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind LastWriteHelp, Mode=OneWay}" />
        </DataTemplate>
        <DataTemplate x:Key="NotesCell" x:DataType="models:RegistryEntry">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind NotePreview, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind NotePreview, Mode=OneWay}" />
        </DataTemplate>
        <DataTemplate x:Key="ChildrenCell" x:DataType="models:RegistryEntry">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ChildrenText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind ChildrenText, Mode=OneWay}" />
        </DataTemplate>
        <DataTemplate x:Key="LinkTargetCell" x:DataType="models:RegistryEntry">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind LinkTarget, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind LinkTarget, Mode=OneWay}" />
        </DataTemplate>
        <DataTemplate x:Key="SizeCell" x:DataType="models:RegistryEntry">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind SizeText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind SizeText, Mode=OneWay}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid
        x:Name="ColumnSurface"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  Column ids are RegistrySortColumn names; the registry list adapts its saved settings to this layout.  -->
        <lists:ColumnListView
            x:Name="Entries"
            EditCommitting="Entries_EditCommitting"
            EditEnded="Entries_EditEnded"
            EditOnF2="False"
            ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
            LayoutChanged="Entries_LayoutChanged"
            SortRequested="Entries_SortRequested"
            VisibleItemsChanged="Entries_VisibleItemsChanged">
            <lists:ColumnListView.LeadingColumn>
                <lists:ListColumn
                    CellTemplate="{StaticResource IconCell}"
                    DefaultWidth="24"
                    Id="Icon" />
            </lists:ColumnListView.LeadingColumn>
            <lists:ColumnListView.Columns>
                <lists:ListColumn
                    MinWidth="80"
                    CellTemplate="{StaticResource NameCell}"
                    FillWeight="2"
                    Header="Name"
                    Id="Name"
                    IsEditable="True"
                    Sortable="True" />
                <lists:ListColumn
                    MinWidth="80"
                    CellTemplate="{StaticResource TypeCell}"
                    DefaultWidth="170"
                    Header="Type"
                    Id="Type"
                    Sortable="True" />
                <lists:ListColumn
                    MinWidth="80"
                    CellTemplate="{StaticResource DataCell}"
                    FillWeight="3"
                    Header="Data"
                    Id="Data"
                    Sortable="True" />
                <lists:ListColumn
                    MinWidth="80"
                    CellTemplate="{StaticResource LastWriteCell}"
                    DefaultVisible="False"
                    DefaultWidth="170"
                    Header="Key last modified"
                    Id="LastWrite"
                    Sortable="True" />
                <lists:ListColumn
                    MinWidth="80"
                    CellTemplate="{StaticResource NotesCell}"
                    DefaultVisible="False"
                    DefaultWidth="220"
                    Header="Notes"
                    Id="Notes"
                    Sortable="True" />
                <lists:ListColumn
                    MinWidth="80"
                    CellTemplate="{StaticResource ChildrenCell}"
                    DefaultVisible="False"
                    DefaultWidth="155"
                    Header="Children"
                    Id="Children"
                    Sortable="True" />
                <lists:ListColumn
                    MinWidth="80"
                    CellTemplate="{StaticResource LinkTargetCell}"
                    DefaultVisible="False"
                    DefaultWidth="220"
                    Header="Link target"
                    Id="LinkTarget"
                    Sortable="True" />
                <lists:ListColumn
                    MinWidth="80"
                    CellTemplate="{StaticResource SizeCell}"
                    DefaultVisible="False"
                    DefaultWidth="110"
                    Header="Size (bytes)"
                    Id="Size"
                    Sortable="True" />
            </lists:ColumnListView.Columns>
        </lists:ColumnListView>
        <StackPanel
            x:Name="EmptyState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Spacing="12"
            Visibility="Collapsed">
            <FontIcon
                FontSize="32"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE721;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="18"
                Text="No matching items" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Try a different filter." />
        </StackPanel>
        <ProgressRing
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <Grid
            x:Name="PreviewPanel"
            Grid.Row="1"
            Padding="6,12"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="PreviewName"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="PreviewData"
                    MaxHeight="66"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.EditValueCommand, Mode=OneWay}"
                Content="Edit value"
                IsEnabled="{x:Bind ViewModel.IsPreviewCurrent, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
