<UserControl
    x:Class="JPSoftworks.Regedit.Controls.Shared.ToolDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JPSoftworks.Regedit.Views.Tools"
    xmlns:models="using:JPSoftworks.Regedit.Models.Tools"
    xmlns:shared="using:JPSoftworks.Regedit.Controls.Shared">
    <Border Style="{StaticResource ToolInspectorStyle}">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="Heading"
                    AutomationProperties.HeadingLevel="Level2"
                    AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                    FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Style="{StaticResource ToolSelectableTextStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="PathText"
                    AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                    Style="{StaticResource ToolSelectableTextStyle}"
                    TextWrapping="Wrap" />
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="Timestamp"
                        AutomationProperties.AutomationId="ToolDetailsTimestamp"
                        AutomationProperties.Name="Selected item local timestamp"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource ToolSelectableTextStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="Metadata"
                        AutomationProperties.AutomationId="ToolDetailsMetadata"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource ToolSelectableTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <InfoBar
                    x:Name="Warning"
                    AutomationProperties.AutomationId="ToolDetailsWarning"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning"
                    Visibility="{x:Bind Warning.IsOpen, Mode=OneWay}" />
                <ContentPresenter x:Name="Related" Visibility="Collapsed" />
                <ItemsControl x:Name="Comparisons">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolComparison">
                            <StackPanel Margin="0,4,0,8" Spacing="4">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{StaticResource ToolSelectableTextStyle}"
                                    Text="{x:Bind Name}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind local:ToolView.TextVisibility(Name)}" />
                                <Grid ColumnSpacing="4" Visibility="{x:Bind local:ToolView.TextVisibility(Before)}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind BeforeLabel}" />
                                    <HyperlinkButton
                                        Grid.Column="1"
                                        MinHeight="24"
                                        Padding="4,0"
                                        AutomationProperties.AutomationId="InspectBeforeValue"
                                        AutomationProperties.Name="Inspect full before value"
                                        Click="InspectBefore_Click"
                                        Content="Inspect"
                                        Visibility="{x:Bind local:ToolView.ValueVisibility(BeforeValue)}" />
                                    <Button
                                        Grid.Column="2"
                                        MinHeight="24"
                                        Padding="4,0"
                                        AutomationProperties.AutomationId="BeforeValueActions"
                                        AutomationProperties.Name="Before value actions"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Before value actions"
                                        Visibility="{x:Bind local:ToolView.ValueVisibility(BeforeValue)}">
                                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                <MenuFlyoutItem
                                                    AutomationProperties.AutomationId="CopyBeforeValueBytes"
                                                    Click="CopyBeforeBytes_Click"
                                                    Tag="{x:Bind BeforeValue}"
                                                    Text="Copy exact bytes" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <TextBlock
                                    AutomationProperties.AutomationId="BeforeText"
                                    FontFamily="{x:Bind shared:ToolDetails.ReadoutFont(BeforeValue, AfterValue)}"
                                    Style="{StaticResource ToolSelectableTextStyle}"
                                    Text="{x:Bind Before}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind local:ToolView.TextVisibility(Before)}" />
                                <Grid
                                    Margin="0,4,0,0"
                                    ColumnSpacing="4"
                                    Visibility="{x:Bind local:ToolView.TextVisibility(After)}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind AfterLabel}" />
                                    <HyperlinkButton
                                        Grid.Column="1"
                                        MinHeight="24"
                                        Padding="4,0"
                                        AutomationProperties.AutomationId="InspectAfterValue"
                                        AutomationProperties.Name="Inspect full after value"
                                        Click="InspectAfter_Click"
                                        Content="Inspect"
                                        Visibility="{x:Bind local:ToolView.ValueVisibility(AfterValue)}" />
                                    <Button
                                        Grid.Column="2"
                                        MinHeight="24"
                                        Padding="4,0"
                                        AutomationProperties.AutomationId="AfterValueActions"
                                        AutomationProperties.Name="After value actions"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="After value actions"
                                        Visibility="{x:Bind local:ToolView.ValueVisibility(AfterValue)}">
                                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                <MenuFlyoutItem
                                                    AutomationProperties.AutomationId="CopyAfterValueBytes"
                                                    Click="CopyAfterBytes_Click"
                                                    Tag="{x:Bind AfterValue}"
                                                    Text="Copy exact bytes" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <TextBlock
                                    AutomationProperties.AutomationId="AfterText"
                                    FontFamily="{x:Bind shared:ToolDetails.ReadoutFont(BeforeValue, AfterValue)}"
                                    Style="{StaticResource ToolSelectableTextStyle}"
                                    Text="{x:Bind After}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind local:ToolView.TextVisibility(After)}" />
                                <Expander
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="CompareRawBytes"
                                    Expanding="RawBytes_Expanding"
                                    Header="First byte difference"
                                    Visibility="{x:Bind shared:ToolDetails.RawBytesVisibility(BeforeValue, AfterValue)}">
                                    <TextBlock
                                        AutomationProperties.AutomationId="ByteDifference"
                                        AutomationProperties.Name="First byte difference"
                                        FontFamily="Consolas"
                                        Style="{StaticResource ToolSelectableTextStyle}"
                                        TextWrapping="Wrap" />
                                </Expander>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Name="Limit"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
