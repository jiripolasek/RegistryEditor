<UserControl
    x:Class="JPSoftworks.Regedit.Views.Tools.FavoritesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lists="using:JPSoftworks.Regedit.Controls.Lists"
    xmlns:local="using:JPSoftworks.Regedit.Controls.Shared"
    xmlns:tools="using:JPSoftworks.Regedit.Views.Tools"
    xmlns:vm="using:JPSoftworks.Regedit.Models.Tools">
    <UserControl.Resources>
        <DataTemplate x:Key="FavoriteRowTemplate" x:DataType="vm:FavoriteRow">
            <Grid
                MinHeight="{ThemeResource ListRowMinHeight}"
                Padding="{ThemeResource ListRowPadding}"
                AutomationProperties.Name="{x:Bind AccessibleName}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Margin="0,3,0,0"
                    VerticalAlignment="Top"
                    FontSize="16"
                    Glyph="{x:Bind Glyph}" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind Title}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Path}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind Path}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Subtitle}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind tools:FavoritesView.TextVisibility(Subtitle)}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FavoriteIconCell" x:DataType="vm:FavoriteRow">
            <FontIcon FontSize="16" Glyph="{x:Bind Glyph}" />
        </DataTemplate>
        <DataTemplate x:Key="FavoriteNameCell" x:DataType="vm:FavoriteRow">
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind Title}"
                TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="FavoritePathCell" x:DataType="vm:FavoriteRow">
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind RegistryPath}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind RegistryPath}" />
        </DataTemplate>
        <DataTemplate x:Key="FavoriteViewCell" x:DataType="vm:FavoriteRow">
            <TextBlock VerticalAlignment="Center" Text="{x:Bind RegistryView}" />
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="P"
            Invoked="InspectDetails_Invoked"
            Modifiers="Menu" />
        <KeyboardAccelerator
            Key="F"
            Invoked="Search_Invoked"
            Modifiers="Control" />
    </UserControl.KeyboardAccelerators>
    <Grid
        x:Name="Layout"
        Padding="24"
        Loaded="View_Loaded"
        SizeChanged="Layout_SizeChanged"
        Unloaded="View_Unloaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <local:ToolPageHeader x:Name="PageHeader" Margin="0,0,0,24" />
        <local:ToolToolbar
            x:Name="LocalControls"
            Grid.Row="1"
            Margin="0,0,0,12"
            SearchChanged="Search_Changed"
            SearchPlaceholder="Search favorites…">
            <local:ToolToolbar.CommandsContent>
                <local:ListCommandBar
                    x:Name="Commands"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="True">
                    <AppBarButton
                        AutomationProperties.HelpText="{x:Bind ViewModel.AddHelp, Mode=OneWay}"
                        Command="{x:Bind ViewModel.AddCommand}"
                        Label="{x:Bind ViewModel.AddLabel}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.AddHelp, Mode=OneWay}">
                        <AppBarButton.Icon>
                            <local:CommandIcon IconSource="{StaticResource AddFavoriteIcon}" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind ViewModel.NewFolderCommand}" Label="New folder">
                        <AppBarButton.Icon>
                            <local:CommandIcon Symbol="NewFolder" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        Command="{x:Bind ViewModel.OpenCommand}"
                        KeyboardAcceleratorTextOverride="{x:Bind OpenShortcut(ViewModel.Compact)}"
                        Label="Open">
                        <AppBarButton.Icon>
                            <local:CommandIcon Symbol="OpenFile" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="OpenNewTabButton"
                        Command="{x:Bind ViewModel.OpenNewTabCommand}"
                        Label="Open in new tab">
                        <AppBarButton.Icon>
                            <local:CommandIcon IconSource="{StaticResource OpenInNewTabIcon}" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton Command="{x:Bind ViewModel.MoveToFolderCommand}" Label="Move to folder…">
                            <AppBarButton.Icon>
                                <local:CommandIcon Symbol="MoveToFolder" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Command="{x:Bind ViewModel.MoveUpCommand}" Label="Move up">
                            <AppBarButton.Icon>
                                <local:CommandIcon Symbol="Up" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Command="{x:Bind ViewModel.MoveDownCommand}" Label="Move down">
                            <AppBarButton.Icon>
                                <local:CommandIcon Glyph="&#xE74B;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            Command="{x:Bind ViewModel.RenameCommand}"
                            KeyboardAcceleratorTextOverride="F2"
                            Label="Rename…">
                            <AppBarButton.Icon>
                                <local:CommandIcon Symbol="Rename" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton
                            Command="{x:Bind ViewModel.RemoveCommand}"
                            KeyboardAcceleratorTextOverride="Del"
                            Label="Remove selected">
                            <AppBarButton.Icon>
                                <local:CommandIcon Symbol="Delete" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </local:ListCommandBar>
            </local:ToolToolbar.CommandsContent>
        </local:ToolToolbar>
        <Grid
            x:Name="Workspace"
            Grid.Row="2"
            ColumnSpacing="16"
            RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeWidth" Width="0" />
                <ColumnDefinition x:Name="ListWidth" Width="*" />
                <ColumnDefinition x:Name="InspectorWidth" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="InspectorHeight" Height="0" />
            </Grid.RowDefinitions>
            <Grid x:Name="FolderPanel" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="FolderHeader" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="TreeHeading"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Folders" />
                    <Button
                        x:Name="FolderActions"
                        Grid.Column="1"
                        AutomationProperties.Name="Folder actions"
                        Style="{StaticResource NavigationButton}"
                        ToolTipService.ToolTip="Folder actions">
                        <Button.Flyout>
                            <MenuFlyout
                                x:Name="ItemMenu"
                                Opening="ItemMenu_Opening"
                                Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem
                                    x:Name="MenuNewFolder"
                                    Command="{x:Bind ViewModel.NewFolderCommand}"
                                    Icon="NewFolder"
                                    Text="New folder" />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.OpenCommand}"
                                    Icon="OpenFile"
                                    KeyboardAcceleratorTextOverride="{x:Bind OpenShortcut(ViewModel.Compact)}"
                                    Text="Open"
                                    Visibility="{x:Bind ViewModel.HasSingleSelection, Mode=OneWay}" />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.OpenNewTabCommand}"
                                    Text="Open in new tab"
                                    Visibility="{x:Bind ViewModel.HasSelectedBookmark, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <IconSourceElement IconSource="{StaticResource OpenInNewTabIcon}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.MoveToFolderCommand}"
                                    Icon="MoveToFolder"
                                    Text="Move to folder…" />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.MoveUpCommand}"
                                    Icon="Up"
                                    Text="Move up"
                                    Visibility="{x:Bind ViewModel.HasSingleSelection, Mode=OneWay}" />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.MoveDownCommand}"
                                    Text="Move down"
                                    Visibility="{x:Bind ViewModel.HasSingleSelection, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.RenameCommand}"
                                    Icon="Rename"
                                    KeyboardAcceleratorTextOverride="F2"
                                    Text="Rename…"
                                    Visibility="{x:Bind ViewModel.HasSingleSelection, Mode=OneWay}" />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.RemoveCommand}"
                                    Icon="Delete"
                                    KeyboardAcceleratorTextOverride="Del"
                                    Text="Remove selected" />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.ToggleDetailsCommand}"
                                    Icon="View"
                                    Text="Details" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                    </Button>
                </Grid>
                <TreeView
                    x:Name="FavoriteTree"
                    Grid.Row="1"
                    AllowDrop="False"
                    AutomationProperties.Name="Favorites folders"
                    CanDragItems="False"
                    CanReorderItems="False"
                    Collapsed="FavoriteTree_Collapsed"
                    Expanding="FavoriteTree_Expanding"
                    ItemInvoked="FavoriteTree_ItemInvoked"
                    KeyDown="Results_KeyDown"
                    SelectionChanged="FavoriteTree_SelectionChanged"
                    SelectionMode="Single">
                    <TreeView.ContextFlyout>
                        <MenuFlyout x:Name="BackgroundMenu" Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.AddCommand}" Text="{x:Bind ViewModel.AddLabel}">
                                <MenuFlyoutItem.Icon>
                                    <IconSourceElement IconSource="{StaticResource AddFavoriteIcon}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.NewFolderCommand}"
                                Icon="NewFolder"
                                Text="New folder" />
                        </MenuFlyout>
                    </TreeView.ContextFlyout>
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="TreeViewNode">
                            <Grid
                                AllowDrop="True"
                                AutomationProperties.Name="{x:Bind ((vm:FavoriteRow)Content).Title, Mode=OneWay}"
                                Background="Transparent"
                                CanDrag="True"
                                ColumnSpacing="8"
                                DoubleTapped="FavoriteFolder_DoubleTapped"
                                DragOver="FavoriteRow_DragOver"
                                DragStarting="FavoriteRow_DragStarting"
                                Drop="FavoriteRow_Drop"
                                DropCompleted="FavoriteRow_DropCompleted"
                                ToolTipService.ToolTip="{x:Bind ((vm:FavoriteRow)Content).Path, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="16" Glyph="{x:Bind ((vm:FavoriteRow)Content).Glyph, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind ((vm:FavoriteRow)Content).Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <StackPanel
                    x:Name="TreeEmpty"
                    Grid.Row="1"
                    Margin="12,48,12,12"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="TreeEmptyTitle"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="TreeEmptyDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <Grid x:Name="Collection" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="CollectionTitle"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="FavoritesFolderTitle"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <HyperlinkButton
                        x:Name="RootFavorites"
                        Grid.Column="1"
                        MinHeight="24"
                        Padding="4,0"
                        AutomationProperties.AutomationId="FavoritesRoot"
                        Click="RootFavorites_Click"
                        Content="All favorites"
                        Visibility="Collapsed" />
                </Grid>

                <Grid Grid.Row="2" Style="{StaticResource ToolListSurfaceStyle}">
                    <lists:ColumnListView x:Name="ResultColumns" CompactItemTemplate="{StaticResource FavoriteRowTemplate}">
                        <lists:ColumnListView.LeadingColumn>
                            <lists:ListColumn
                                CellTemplate="{StaticResource FavoriteIconCell}"
                                DefaultWidth="20"
                                Id="Icon" />
                        </lists:ColumnListView.LeadingColumn>
                        <lists:ColumnListView.Columns>
                            <lists:ListColumn
                                MinWidth="100"
                                CanHide="False"
                                CellTemplate="{StaticResource FavoriteNameCell}"
                                FillWeight="2"
                                Header="Name"
                                Id="Name" />
                            <lists:ListColumn
                                MinWidth="120"
                                CellTemplate="{StaticResource FavoritePathCell}"
                                FillWeight="5"
                                Header="Registry path"
                                Id="Path" />
                            <lists:ListColumn
                                CellTemplate="{StaticResource FavoriteViewCell}"
                                DefaultWidth="80"
                                Header="View"
                                Id="View" />
                        </lists:ColumnListView.Columns>
                    </lists:ColumnListView>
                    <StackPanel
                        x:Name="Empty"
                        MaxWidth="320"
                        Margin="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Spacing="8">
                        <TextBlock
                            x:Name="EmptyTitle"
                            FontWeight="SemiBold"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="EmptyDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <TextBlock
                    x:Name="Count"
                    Grid.Row="3"
                    Margin="0,8,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
            <local:ToolDetails
                x:Name="Details"
                Grid.Column="2"
                Visibility="Collapsed" />
            <local:ToolPaneSplitter x:Name="DetailsSplitter" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
