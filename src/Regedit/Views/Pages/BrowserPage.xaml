                                    <AppBarButton.Icon>
                                        <shared:CommandIcon>
                                            <shared:CommandIcon.IconSource>
                                                <FontIconSource FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF56D;" />
                                            </shared:CommandIcon.IconSource>
                                        </shared:CommandIcon>
                                    </AppBarButton.Icon>
                                </AppBarButton>
