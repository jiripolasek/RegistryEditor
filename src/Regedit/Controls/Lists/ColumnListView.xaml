<UserControl
    x:Class="JPSoftworks.Regedit.Controls.Lists.ColumnListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JPSoftworks.Regedit.Controls.Lists">
    <UserControl.Resources>
        <Style
            x:Key="ColumnHeaderButtonStyle"
            BasedOn="{StaticResource SubtleButtonStyle}"
            TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <!--  Sort direction chevron beside a header; smaller and quieter than the header text.  -->
        <Style x:Key="ColumnHeaderSortIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="ColumnRowTemplate">
            <local:ColumnRow Padding="0,3" />
        </DataTemplate>
        <DataTemplate x:Key="CheckedCompactTemplate">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    AutomationProperties.Name="Select item"
                    Click="RowCheckBoxClicked"
                    DoubleTapped="RowCheckBoxDoubleTapped"
                    IsTabStop="False"
                    Loaded="SelectionCheckBoxLoaded" />
                <Border Grid.Column="1" Loaded="CompactContentLoaded" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer
        x:Name="HorizontalScroll"
        HorizontalScrollBarVisibility="Auto"
        HorizontalScrollMode="Enabled"
        VerticalScrollBarVisibility="Disabled"
        VerticalScrollMode="Disabled">
        <Grid x:Name="Surface">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <local:ColumnHeaderRow
                x:Name="Header"
                Padding="12,0,12,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                TabFocusNavigation="Local">
                <CheckBox
                    x:Name="SelectAllBox"
                    x:FieldModifier="internal"
                    AutomationProperties.AutomationId="SelectAllItems"
                    AutomationProperties.Name="Select all items"
                    Checked="SelectAllToggled"
                    Loaded="SelectionCheckBoxLoaded"
                    TabIndex="0"
                    ToolTipService.ToolTip="Select or clear all items"
                    Unchecked="SelectAllToggled"
                    Visibility="Collapsed">
                    <CheckBox.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="SystemControlTransparentBrush" />
                                    <SolidColorBrush
                                        x:Key="CheckBoxCheckBackgroundStrokeUnchecked"
                                        Color="{StaticResource ControlStrongStrokeColorDefault}"
                                        Opacity="0.95" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="CheckBoxCheckBackgroundStrokeUnchecked" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminate" ResourceKey="ControlAltFillColorSecondaryBrush" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" ResourceKey="CheckBoxCheckBackgroundFillUncheckedPointerOver" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" ResourceKey="CheckBoxCheckBackgroundFillUncheckedPressed" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" ResourceKey="CheckBoxCheckBackgroundStrokeUnchecked" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" ResourceKey="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" ResourceKey="CheckBoxCheckBackgroundStrokeUncheckedPressed" />
                                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminate" ResourceKey="SystemControlTransparentBrush" />
                                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" ResourceKey="SystemControlTransparentBrush" />
                                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" ResourceKey="SystemControlTransparentBrush" />
                                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminateDisabled" ResourceKey="SystemControlTransparentBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <StaticResource x:Key="CheckBoxCheckBackgroundFillUnchecked" ResourceKey="SystemControlTransparentBrush" />
                                    <SolidColorBrush
                                        x:Key="CheckBoxCheckBackgroundStrokeUnchecked"
                                        Color="{StaticResource ControlStrongStrokeColorDefault}"
                                        Opacity="0.72" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="CheckBoxCheckBackgroundStrokeUnchecked" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminate" ResourceKey="ControlAltFillColorSecondaryBrush" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" ResourceKey="CheckBoxCheckBackgroundFillUncheckedPointerOver" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" ResourceKey="CheckBoxCheckBackgroundFillUncheckedPressed" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" ResourceKey="CheckBoxCheckBackgroundStrokeUnchecked" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" ResourceKey="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" />
                                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" ResourceKey="CheckBoxCheckBackgroundStrokeUncheckedPressed" />
                                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminate" ResourceKey="SystemControlTransparentBrush" />
                                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" ResourceKey="SystemControlTransparentBrush" />
                                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" ResourceKey="SystemControlTransparentBrush" />
                                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminateDisabled" ResourceKey="SystemControlTransparentBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast" />
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </CheckBox.Resources>
                </CheckBox>
            </local:ColumnHeaderRow>
            <ListView
                x:Name="Items"
                Grid.Row="1"
                Background="Transparent"
                FocusVisualPrimaryThickness="1"
                FocusVisualSecondaryThickness="0"
                IsTabStop="True"
                SelectionMode="Extended"
                TabFocusNavigation="Local">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="FocusVisualPrimaryThickness" Value="1" />
                        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="MinHeight" Value="28" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <Canvas
                x:Name="SelectionLayer"
                Grid.Row="1"
                Background="Transparent"
                PointerCanceled="SelectionCanceled"
                PointerMoved="SelectionMoved"
                PointerReleased="SelectionReleased"
                Visibility="Collapsed">
                <Border
                    x:Name="SelectionRectangle"
                    AutomationProperties.AccessibilityView="Raw"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.16" />
                </Border>
            </Canvas>
        </Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SelectionCheckBoxStates">
                <VisualState x:Name="NativeCheckBoxes" />
                <VisualState x:Name="CustomCheckBoxes">
                    <VisualState.Setters>
                        <Setter Target="Items.IsMultiSelectCheckBoxEnabled" Value="False" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</UserControl>
