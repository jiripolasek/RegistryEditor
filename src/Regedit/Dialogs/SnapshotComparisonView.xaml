<UserControl
    x:Class="JPSoftworks.Regedit.Dialogs.SnapshotComparisonView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:JPSoftworks.Regedit.Core.Snapshots"
    xmlns:local="using:JPSoftworks.Regedit.Controls.Shared">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock
                FontWeight="SemiBold"
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.Scope}"
                TextWrapping="Wrap" />
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Summary}"
                TextWrapping="Wrap" />
        </StackPanel>
        <local:ListCommandBar
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True">
            <AppBarButton
                x:Name="ExportDifferencesButton"
                Command="{x:Bind ViewModel.ExportCommand}"
                Label="Export selected">
                <AppBarButton.Icon>
                    <local:CommandIcon Symbol="Save" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Command="{x:Bind ViewModel.CopyPowerShellCommand}" Label="Copy PowerShell">
                <AppBarButton.Icon>
                    <local:CommandIcon Symbol="Copy" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Command="{x:Bind ViewModel.CopyRegExeCommand}" Label="Copy reg.exe (.cmd)">
                <AppBarButton.Icon>
                    <local:CommandIcon Symbol="Copy" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Click="SelectAll_Click" Label="Select all">
                <AppBarButton.Icon>
                    <local:CommandIcon Symbol="SelectAll" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Click="ClearSelection_Click" Label="Clear selection">
                <AppBarButton.Icon>
                    <local:CommandIcon Symbol="ClearSelection" />
                </AppBarButton.Icon>
            </AppBarButton>
        </local:ListCommandBar>
        <ListView
            x:Name="DifferencesList"
            Grid.Row="2"
            AutomationProperties.Name="Snapshot differences"
            ItemsSource="{x:Bind ViewModel.Comparison.Differences}"
            SelectionChanged="Selection_Changed"
            SelectionMode="Multiple">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:RegistryDifference">
                    <Grid
                        Padding="0,6"
                        ColumnSpacing="12"
                        ToolTipService.ToolTip="{x:Bind Location.Address}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                            Text="{x:Bind Change}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Location.Address}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Text="{x:Bind Types}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock
            x:Name="NoDifferences"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="No differences. Keys, types, and raw value bytes match."
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.NoDifferences}" />
        <StackPanel Grid.Row="3" Spacing="12">
            <TextBox
                x:Name="SelectedTarget"
                MaxHeight="100"
                Header="Selected target"
                Style="{StaticResource ToolReadoutStyle}"
                Text="{x:Bind ViewModel.Target, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasTarget, Mode=OneWay}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="BeforeData"
                    MaxHeight="170"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Before snapshot value"
                    FontFamily="Consolas"
                    FontSize="12"
                    Header="Before"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.BeforeDetail, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="AfterData"
                    Grid.Column="1"
                    MaxHeight="170"
                    AcceptsReturn="True"
                    AutomationProperties.Name="After snapshot value"
                    FontFamily="Consolas"
                    FontSize="12"
                    Header="After"
                    IsReadOnly="True"
                    Text="{x:Bind ViewModel.AfterDetail, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
        <InfoBar
            x:Name="ResultMessage"
            Grid.Row="4"
            IsClosable="True"
            IsOpen="False" />
    </Grid>
</UserControl>
