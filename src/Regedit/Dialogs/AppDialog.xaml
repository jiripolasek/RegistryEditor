<ContentDialog
    x:Class="JPSoftworks.Regedit.Dialogs.AppDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource AppDialogStyle}">
    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentPanel" Style="{StaticResource DialogContentPanelStyle}">
            <TextBlock
                x:Name="MessageText"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <ContentPresenter
                x:Name="BodyHost"
                HorizontalContentAlignment="Stretch"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="ErrorText"
                AutomationProperties.AutomationId="DialogError"
                AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource DialogErrorTextStyle}"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
