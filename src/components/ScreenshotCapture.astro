---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
  window?: boolean;
  wide?: boolean;
}

const { image, alt, caption, window: isWindow = false, wide = false } = Astro.props;
const widths = [400, 640, 960, 1280].filter((width) => width < image.width).concat(image.width);
const sizes = wide
  ? '(max-width: 600px) calc(100vw - 36px), (max-width: 1224px) calc(100vw - 64px), 1160px'
  : '(max-width: 600px) calc(100vw - 36px), (max-width: 800px) calc(100vw - 64px), (max-width: 1224px) calc(59vw - 66px), 660px';
---

<figure class:list={['feature-preview', 'capture-preview', { 'capture-window': isWindow, 'capture-fade': wide }]}>
  <a href={image.src} target="_blank" rel="noopener" aria-label={'Open screenshot at full size in a new tab: ' + alt}>
    <Image class="capture-detail" src={image} alt={alt} widths={widths} sizes={sizes} format="png" loading="lazy" />
  </a>
  <figcaption>{caption}</figcaption>
</figure>
