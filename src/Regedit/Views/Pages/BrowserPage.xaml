                                                Text="Capture branch snapshot…" />
                                            <MenuFlyoutItem
                                                x:Name="CompareLastSnapshotMenu"
                                                Command="{x:Bind ViewModel.Snapshots.CompareLastCommand}"
                                                Icon="Switch"
                                                Text="Compare last capture with registry" />
                                            <MenuFlyoutItem
                                                x:Name="CompareSnapshotMenu"
                                                Command="{x:Bind ViewModel.Snapshots.CompareFileCommand}"
                                                Icon="Switch"
                                                Text="Compare saved snapshot with registry…" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                x:Name="LastComparisonMenu"
                                                Command="{x:Bind ViewModel.Snapshots.ShowComparisonCommand}"
