<Window
    x:Class="JPSoftworks.Regedit.Views.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:JPSoftworks.Regedit.Models.Tools"
    xmlns:notifications="using:JPSoftworks.Notifications.WinUI"
    xmlns:shared="using:JPSoftworks.Regedit.Controls.Shared"
    xmlns:vm="using:JPSoftworks.Regedit.ViewModels.Shell"
    Title="Registry Editor">
    <Grid
        x:Name="Shell"
        AllowDrop="True"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="Shell_Loaded"
        SizeChanged="Shell_SizeChanged">
        <FlyoutBase.AttachedFlyout>
            <!--  Exception: open the application menu inward from the top-right button to keep it inside the window.  -->
            <MenuFlyout x:Name="ApplicationMenu" Placement="BottomEdgeAlignedRight">
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.NewTabCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl+T"
                    Text="New tab">
                    <MenuFlyoutItem.Icon>
                        <FontIcon FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xEBE9;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.CloseCurrentTabCommand}"
                    Icon="Cancel"
                    KeyboardAcceleratorTextOverride="Ctrl+W"
                    Text="Close tab" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.ReopenClosedTabCommand}"
                    Icon="Undo"
                    KeyboardAcceleratorTextOverride="Ctrl+Shift+T"
                    Text="Reopen closed tab" />
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem x:Name="ApplicationTools" Text="Tools">
                    <MenuFlyoutSubItem.Icon>
                        <FontIcon
                            FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                            FontSize="16"
                            Glyph="&#xEE7F;" />
                    </MenuFlyoutSubItem.Icon>
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Command="{x:Bind RegistryMenu.ImportCommand}"
                    Icon="OpenFile"
                    Text="Import registry file…" />
                <MenuFlyoutItem
                    Command="{x:Bind RegistryMenu.ExportAllCommand}"
                    Icon="Save"
                    Text="Export entire registry…" />
                <MenuFlyoutSubItem Icon="World" Text="Network registry">
                    <MenuFlyoutItem
                        Command="{x:Bind RegistryMenu.ConnectCommand}"
                        Icon="Link"
                        Text="Connect network registry…" />
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.DisconnectCommand}"
                        Icon="DisconnectDrive"
                        Text="Disconnect network registry" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Command="{x:Bind RegistryMenu.ElevateCommand}" Text="Open as administrator">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    AutomationProperties.AutomationId="RecentNotifications"
                    Click="NotificationHistory_Click"
                    Icon="Message"
                    Text="Recent notifications" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    Icon="Setting"
                    KeyboardAcceleratorTextOverride="Ctrl+,"
                    Text="Settings" />
                <MenuFlyoutItem
                    Command="{x:Bind ViewModel.OpenShortcutsCommand}"
                    Icon="Keyboard"
                    KeyboardAcceleratorTextOverride="Ctrl+/"
                    Text="Keyboard shortcuts" />
                <MenuFlyoutItem
                    Click="HelpAndAbout_Click"
                    Icon="Help"
                    KeyboardAcceleratorTextOverride="F1"
                    Text="Help and about" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{x:Bind ViewModel.ExitCommand}" Text="Close application" />
            </MenuFlyout>
        </FlyoutBase.AttachedFlyout>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="PanelBackgroundBrush" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="PanelBackgroundBrush" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="PanelBackgroundBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <Style TargetType="TabViewItem">
                    <Setter Property="MinWidth" Value="160" />
                    <Setter Property="MaxWidth" Value="300" />
                </Style>
                <Style
                    x:Key="ToolHeaderButton"
                    BasedOn="{StaticResource ToolbarButtonStyle}"
                    TargetType="Button">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <!--  No padding: 32 px minus 8 px padding and the 1 px border leaves 14 px and clips 16 px icons.  -->
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style
                    x:Key="ToolHeaderToggleButton"
                    BasedOn="{StaticResource DefaultToggleButtonStyle}"
                    TargetType="ToggleButton">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="BottomPaneRow" Height="0" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="ApplicationEscape_Invoked" />
            <KeyboardAccelerator
                Key="T"
                Invoked="ReopenTab_Invoked"
                Modifiers="Control,Shift" />
            <KeyboardAccelerator Key="F1" Invoked="HelpAndAbout_Invoked" />
            <KeyboardAccelerator Key="F3" Invoked="FindNextResult_Invoked" />
            <KeyboardAccelerator Key="F10" Invoked="FocusApplicationMenu_Invoked" />
            <KeyboardAccelerator Key="F6" Invoked="CyclePaneFocus_Invoked" />
            <KeyboardAccelerator Key="F9" Invoked="Tools_Invoked" />
            <KeyboardAccelerator
                Key="J"
                Invoked="BottomPane_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="T"
                Invoked="NewTab_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="W"
                Invoked="CloseTab_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Tab"
                Invoked="NextTab_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Tab"
                Invoked="PreviousTab_Invoked"
                Modifiers="Control,Shift" />
        </Grid.KeyboardAccelerators>
        <TabView
            x:Name="Tabs"
            VerticalAlignment="Stretch"
            AddTabButtonClick="AddTab_Click"
            AutomationProperties.Name="Registry tabs"
            CanReorderTabs="True"
            CloseButtonOverlayMode="Always"
            SelectionChanged="Tabs_SelectionChanged"
            TabCloseRequested="Tab_CloseRequested"
            TabItemsSource="{x:Bind ViewModel.Tabs}"
            TabWidthMode="SizeToContent">
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="vm:WindowTab">
                    <TabViewItem
                        AutomationProperties.HelpText="{x:Bind Tooltip, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                        ContextRequested="Tab_ContextRequested"
                        ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                        <TabViewItem.Header>
                            <TextBlock
                                MaxWidth="208"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </TabViewItem.Header>
                        <TabViewItem.IconSource>
                            <FontIconSource FontFamily="{x:Bind IconFontFamily}" Glyph="{x:Bind Glyph}" />
                        </TabViewItem.IconSource>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
            <TabView.TabStripHeader>
                <StackPanel
                    x:Name="TabStripHeader"
                    MinHeight="40"
                    Margin="8,0,4,0"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Border x:Name="WindowIconArea" Width="32">
                        <Image
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Modern Registry Editor"
                            Source="ms-appx:///Assets/TitleBarIcon.png"
                            ToolTipService.ToolTip="Modern Registry Editor" />
                    </Border>
                    <FontIcon
                        x:Name="AdministratorShield"
                        Width="24"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Content"
                        AutomationProperties.Name="Running as administrator"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xEA18;"
                        ToolTipService.ToolTip="Running as administrator"
                        Visibility="Collapsed" />
                    <Button
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="RunningWatches"
                        Command="{x:Bind ViewModel.ShowRunningWatchCommand}"
                        Content="{x:Bind ViewModel.RunningWatchText, Mode=OneWay}"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Open the most recently started running watch"
                        Visibility="{x:Bind RunningWatchVisibility(ViewModel.RunningWatchCount), Mode=OneWay}" />
                </StackPanel>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="48" />
                        <ColumnDefinition x:Name="CaptionInset" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Name="TitleBarDragRegion"
                        Background="Transparent"
                        Loaded="TitleBarDragRegion_Loaded" />
                </Grid>
            </TabView.TabStripFooter>

        </TabView>
        <SplitView
            x:Name="ToolsSplit"
            Grid.Row="2"
            DisplayMode="Overlay"
            IsPaneOpen="{x:Bind ViewModel.IsPaneOpen, Mode=TwoWay}"
            OpenPaneLength="360"
            PaneBackground="Transparent"
            PaneClosed="ToolsPane_Closed"
            PaneClosing="ToolsPane_Closing"
            PanePlacement="Right">
            <SplitView.Pane>
                <Grid
                    x:Name="ToolPane"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    KeyDown="ToolPane_KeyDown"
                    Style="{StaticResource TabSurfaceStyle}">
                    <Grid.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="F"
                            Invoked="ToolSearch_Invoked"
                            Modifiers="Control" />
                    </Grid.KeyboardAccelerators>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <shared:ResizeThumb
                        x:Name="ToolResize"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AutomationProperties.AutomationId="ToolResize"
                        AutomationProperties.Name="Resize tool panel"
                        Background="Transparent"
                        DragCompleted="ToolResize_DragCompleted"
                        DragDelta="ToolResize_DragDelta"
                        IsTabStop="True"
                        KeyDown="ToolResize_KeyDown"
                        UseSystemFocusVisuals="True" />
                    <Grid Grid.Column="1" Padding="6,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="ToolSelector"
                                Height="32"
                                MinHeight="32"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Tool"
                                SelectionChanged="ToolSelector_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ToolChoice">
                                        <TextBlock Text="{x:Bind Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <shared:PanelCommandStrip
                                x:Name="SidebarActions"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                ButtonStyle="{StaticResource ToolHeaderButton}"
                                ToggleButtonStyle="{StaticResource ToolHeaderToggleButton}">
                                <shared:PanelCommandStrip.Resources>
                                    <ResourceDictionary>
                                        <ResourceDictionary.ThemeDictionaries>
                                            <ResourceDictionary x:Key="Light">
                                                <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="Dark">
                                                <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                                <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                                <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                                <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                            </ResourceDictionary>
                                            <ResourceDictionary x:Key="HighContrast" />
                                        </ResourceDictionary.ThemeDictionaries>
                                    </ResourceDictionary>
                                </shared:PanelCommandStrip.Resources>
                            </shared:PanelCommandStrip>
                            <Button
                                x:Name="ExpandToolButton"
                                Grid.Column="2"
                                AutomationProperties.Name="Open tool in tab"
                                Click="OpenToolTab_Click"
                                Style="{StaticResource ToolHeaderButton}"
                                ToolTipService.ToolTip="Open in tab">
                                <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                            </Button>
                            <Button
                                x:Name="PinTools"
                                Grid.Column="3"
                                AutomationProperties.Name="Pin tool panel"
                                Click="PinTools_Click"
                                Style="{StaticResource ToolHeaderButton}"
                                ToolTipService.ToolTip="Pin tool panel">
                                <FontIcon
                                    x:Name="PinToolsIcon"
                                    FontSize="14"
                                    Glyph="&#xE718;" />
                            </Button>
                            <Button
                                x:Name="CloseToolButton"
                                Grid.Column="4"
                                AutomationProperties.Name="Close tool panel"
                                Click="CloseTools_Click"
                                Style="{StaticResource ToolHeaderButton}"
                                ToolTipService.ToolTip="Close tool panel (Esc)">
                                <FontIcon FontSize="16" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                        <ContentControl
                            x:Name="ToolContent"
                            Grid.Row="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
                    </Grid>
                </Grid>
            </SplitView.Pane>
            <ContentControl
                x:Name="ActiveTabContent"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </SplitView>
        <Grid
            x:Name="BottomPane"
            Grid.Row="3"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            KeyDown="BottomPane_KeyDown"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="BottomUpperRow" Height="Auto" />
                <RowDefinition x:Name="BottomLowerRow" Height="*" />
            </Grid.RowDefinitions>
            <shared:ResizeThumb
                Grid.RowSpan="2"
                Height="6"
                Margin="0,-3,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="BottomPanelResize"
                AutomationProperties.Name="Resize bottom panel"
                Background="Transparent"
                Canvas.ZIndex="1"
                DragCompleted="ToolResize_DragCompleted"
                DragDelta="BottomResize_DragDelta"
                IsTabStop="True"
                KeyDown="BottomResize_KeyDown"
                ResizeDirection="Vertical"
                UseSystemFocusVisuals="True" />
            <TabView
                x:Name="BottomTabs"
                AutomationProperties.AutomationId="BottomTabs"
                AutomationProperties.Name="Tool and search tabs"
                CanReorderTabs="True"
                CloseButtonOverlayMode="Always"
                Loaded="BottomTabs_Loaded"
                SelectionChanged="BottomTabs_SelectionChanged"
                TabCloseRequested="BottomTabs_CloseRequested"
                TabItemsSource="{x:Bind ViewModel.BottomTabs}"
                TabWidthMode="SizeToContent">
                <FlyoutBase.AttachedFlyout>
                    <MenuFlyout x:Name="BottomPanelMenu" Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.OpenToolCommand}"
                            CommandParameter="{x:Bind models:ToolKind.Journal}"
                            Icon="Clock"
                            Text="Change journal" />
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.OpenToolCommand}"
                            CommandParameter="{x:Bind models:ToolKind.Watches}"
                            Text="Watches">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7B3;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </FlyoutBase.AttachedFlyout>
                <TabView.Resources>
                    <Style TargetType="TabViewItem">
                        <Setter Property="MinWidth" Value="100" />
                        <Setter Property="MaxWidth" Value="240" />
                    </Style>
                </TabView.Resources>
                <TabView.TabItemTemplate>
                    <DataTemplate x:DataType="vm:WindowTab">
                        <TabViewItem AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                            <TabViewItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing
                                        Width="14"
                                        Height="14"
                                        MinWidth="0"
                                        MinHeight="0"
                                        IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                        Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                    <TextBlock
                                        MaxWidth="160"
                                        Text="{x:Bind HeaderTitle, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </TabViewItem.Header>
                            <TabViewItem.IconSource>
                                <FontIconSource FontFamily="{x:Bind IconFontFamily}" Glyph="{x:Bind Glyph}" />
                            </TabViewItem.IconSource>
                        </TabViewItem>
                    </DataTemplate>
                </TabView.TabItemTemplate>
                <TabView.TabStripFooter>
                    <Grid
                        Margin="8,0,8,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--  Rendered from the active panel view's IPanelView description; views never hand over their own controls.  -->
                        <Grid
                            x:Name="BottomFilter"
                            Grid.Column="1"
                            Width="200"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <Grid.Resources>
                                <ResourceDictionary Source="/Resources/ToolbarSearchResources.xaml" />
                            </Grid.Resources>
                            <TextBox
                                x:Name="PanelSearchBox"
                                Padding="32,5,12,5"
                                TextChanged="PanelSearchBox_TextChanged" />
                            <FontIcon
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE721;"
                                IsHitTestVisible="False" />
                        </Grid>
                        <!--  Tool commands use the same header button styles as Open in main tab and Hide panel.  -->
                        <shared:PanelCommandStrip
                            x:Name="BottomActions"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            ButtonStyle="{StaticResource ToolHeaderButton}"
                            ToggleButtonStyle="{StaticResource ToolHeaderToggleButton}"
                            Visibility="Collapsed">
                            <shared:PanelCommandStrip.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <!--  Unchecked toggles use the subtle button fills; checked keeps the accent.  -->
                                        <ResourceDictionary x:Key="Default">
                                            <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                            <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                            <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                            <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="HighContrast" />
                                    </ResourceDictionary.ThemeDictionaries>
                                </ResourceDictionary>
                            </shared:PanelCommandStrip.Resources>
                        </shared:PanelCommandStrip>
                        <StackPanel
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Border
                                Width="1"
                                Height="20"
                                Margin="0,0,6,0"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Button
                                AutomationProperties.Name="Open panel tab in main tab"
                                Click="PromoteBottomTab_Click"
                                Style="{StaticResource ToolHeaderButton}"
                                ToolTipService.ToolTip="Open in main tab">
                                <FontIcon FontSize="16" Glyph="&#xE8A7;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Hide bottom panel"
                                Click="HideBottomPane_Click"
                                Style="{StaticResource ToolHeaderButton}"
                                ToolTipService.ToolTip="Hide panel (Esc)">
                                <FontIcon FontSize="16" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </TabView.TabStripFooter>
            </TabView>
            <Border
                x:Name="BottomContentSurface"
                Grid.Row="1"
                Background="{ThemeResource PanelBackgroundBrush}">
                <ContentControl
                    x:Name="BottomContent"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>
        <notifications:NotificationHost
            x:Name="NotificationOverlay"
            Grid.Row="1"
            Grid.RowSpan="3"
            AutomationProperties.AutomationId="ApplicationNotifications" />
    </Grid>
</Window>
