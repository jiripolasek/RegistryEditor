<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="JPSoftworks.ColumnList.Sample.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lists="using:JPSoftworks.Regedit.Controls.Lists"
    xmlns:local="using:JPSoftworks.ColumnList.Sample"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <DataTemplate x:Key="IconCell" x:DataType="local:SampleEntry">
            <FontIcon
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="{x:Bind Glyph}" />
        </DataTemplate>
        <DataTemplate x:Key="NameCell" x:DataType="local:SampleEntry">
            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                lists:ColumnListView.IsDragHandle="True"
                DragStarting="EntryName_DragStarting"
                FontWeight="SemiBold"
                Text="{x:Bind Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="DataCell" x:DataType="local:SampleEntry">
            <TextBlock
                VerticalAlignment="Center"
                FontFamily="Cascadia Mono, Consolas"
                Text="{x:Bind Data}"
                TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate x:Key="CompactEvent" x:DataType="local:SampleEvent">
            <StackPanel
                Padding="0,4"
                AutomationProperties.Name="{x:Bind Path}"
                Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="{x:Bind Subject}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Path}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Grid
        Padding="16"
        ColumnSpacing="16"
        RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Registry-like list (10,000 rows)" />
        <lists:ColumnListView
            x:Name="Registry"
            Grid.Row="1"
            x:FieldModifier="internal"
            AutomationProperties.Name="Registry-like list"
            EditCommitting="Registry_EditCommitting"
            LayoutChanged="Registry_LayoutChanged"
            SelectionCheckBoxes="Overlay"
            SortRequested="Registry_SortRequested">
            <lists:ColumnListView.LeadingColumn>
                <lists:ListColumn
                    CellTemplate="{StaticResource IconCell}"
                    DefaultWidth="24"
                    Id="Icon" />
            </lists:ColumnListView.LeadingColumn>
            <lists:ColumnListView.Columns>
                <lists:ListColumn
                    MinWidth="80"
                    CanHide="False"
                    CellTemplate="{StaticResource NameCell}"
                    FillWeight="2"
                    Header="Name"
                    Id="Name"
                    IsEditable="True"
                    Sortable="True" />
                <lists:ListColumn
                    MinWidth="60"
                    DefaultWidth="140"
                    Header="Type"
                    Id="Type"
                    Sortable="True" />
                <lists:ListColumn
                    MinWidth="80"
                    CellTemplate="{StaticResource DataCell}"
                    FillWeight="3"
                    Header="Data"
                    Id="Data"
                    Sortable="True" />
                <lists:ListColumn
                    DefaultWidth="150"
                    Header="Last write"
                    Id="LastWrite"
                    Sortable="True" />
                <lists:ListColumn
                    DefaultVisible="False"
                    DefaultWidth="100"
                    Header="Size"
                    HeaderAlignment="Right"
                    Id="Size"
                    Sortable="True" />
            </lists:ColumnListView.Columns>
        </lists:ColumnListView>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="16">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Tool-like list" />
            <ToggleSwitch
                x:Name="DockedSwitch"
                AutomationProperties.AutomationId="DockedSwitch"
                IsOn="True"
                OffContent="Undocked (stacked rows)"
                OnContent="Docked (columns)"
                Toggled="DockedSwitch_Toggled" />
        </StackPanel>
        <lists:ColumnListView
            x:Name="Tools"
            Grid.Row="3"
            x:FieldModifier="internal"
            AutomationProperties.Name="Tool-like list"
            CompactItemTemplate="{StaticResource CompactEvent}"
            EditCommitting="Tools_EditCommitting"
            LayoutChanged="Tools_LayoutChanged">
            <lists:ColumnListView.Columns>
                <lists:ListColumn
                    MinWidth="64"
                    FillWeight="2"
                    Header="Subject"
                    Id="Subject" />
                <lists:ListColumn
                    MinWidth="64"
                    FillWeight="6"
                    Header="Registry path"
                    Id="Path" />
                <lists:ListColumn
                    MinWidth="64"
                    FillWeight="2"
                    Header="Summary"
                    Id="Summary"
                    IsEditable="True" />
            </lists:ColumnListView.Columns>
        </lists:ColumnListView>

        <ScrollViewer
            Grid.RowSpan="4"
            Grid.Column="1"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Inspector" />
                <TextBlock x:Name="SelectionText" AutomationProperties.AutomationId="SelectionText" />
                <TextBlock x:Name="SortText" AutomationProperties.AutomationId="SortText" />
                <Border
                    x:Name="DropTarget"
                    MinHeight="56"
                    Padding="12"
                    x:FieldModifier="internal"
                    AllowDrop="True"
                    AutomationProperties.Name="Item drop target"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    DragOver="Names_DragOver"
                    Drop="Names_Drop">
                    <TextBlock
                        x:Name="DroppedNames"
                        VerticalAlignment="Center"
                        x:FieldModifier="internal"
                        MaxLines="3"
                        Text="Drop item names here"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </Border>
                <ComboBox
                    Header="Selection check boxes"
                    SelectedIndex="2"
                    SelectionChanged="SelectionCheckBoxes_Changed">
                    <x:String>Default</x:String>
                    <x:String>Before each item</x:String>
                    <x:String>Over the leading cell</x:String>
                </ComboBox>
                <CheckBox
                    x:Name="DragSelectionOption"
                    x:FieldModifier="internal"
                    Click="DragSelectionOption_Click"
                    Content="Drag to select rows"
                    IsChecked="True" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="Reset_Click" Content="Reset" />
                    <Button Click="FitAll_Click" Content="Fit all" />
                    <Button Click="Save_Click" Content="Save" />
                    <Button Click="Reload_Click" Content="Reload" />
                </StackPanel>
                <ComboBox
                    x:Name="DensityBox"
                    Header="Row density (ListDensity)"
                    SelectedIndex="1"
                    SelectionChanged="Density_SelectionChanged">
                    <x:String>Compact (0)</x:String>
                    <x:String>Standard (3)</x:String>
                    <x:String>Spacious (10)</x:String>
                </ComboBox>
                <TextBlock Text="Registry layout" />
                <TextBox
                    x:Name="LayoutText"
                    MinHeight="260"
                    AcceptsReturn="True"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="11"
                    IsReadOnly="True"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Drag a name to copy the selected items. Drag beside a name to select rows. Ctrl toggles rows and Shift extends from the last selected row. F2 or a slow second click renames a selected row. Drag a header to reorder it or press Ctrl+Shift+Left/Right. Drag a header edge to resize or double-click it to fit. Right-click a header to show or reset columns."
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
