                        <MenuFlyout Opening="ToolsMenu_Opening" Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                            FontSize="16"
                            Glyph="&#xEE7F;" />
                        <TextBlock Text="Tools" />
                        <FontIcon FontSize="10" Glyph="&#xE70D;" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="GlobalMenuButton"
                    AccessKey="F"
                    AutomationProperties.AcceleratorKey="Alt+F"
                    AutomationProperties.Name="Application menu"
                    Style="{StaticResource NavigationButton}"
                    ToolTipService.ToolTip="Application menu (Alt+F)">
                    <FontIcon FontSize="16" Glyph="&#xE700;" />
                </Button>
            </StackPanel>
        </Grid>
        <Border
            x:Name="FavoritesBar"
            Grid.Row="1"
            Margin="8,0,8,4"
            Padding="0,0,0,4"
            Background="Transparent"
            Visibility="Collapsed">
            <Grid
                x:Name="FavoriteBarHost"
                AutomationProperties.AutomationId="FavoritesBar"
                AutomationProperties.Name="Favorites bar"
                SizeChanged="FavoriteBarHost_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    x:Name="FavoriteBarItems"
                    Orientation="Horizontal"
                    Spacing="2" />
                <Button
                    x:Name="FavoriteBarOverflowButton"
                    Grid.Column="1"
                    Width="32"
                    Margin="2,0,0,0"
                    AutomationProperties.AutomationId="FavoriteBarOverflowButton"
                    AutomationProperties.Name="More favorites"
                    Style="{StaticResource FavoritesBarButtonStyle}"
                    ToolTipService.ToolTip="More favorites"
                    Visibility="Collapsed">
                    <FontIcon
                        FontSize="12"
                        Glyph="&#xE76C;"
                        MirroredWhenRightToLeft="True" />
                </Button>
            </Grid>
        </Border>
        <Grid x:Name="ContentGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="TreeColumn"
                    Width="290"
                    MinWidth="0"
                    MaxWidth="600" />
