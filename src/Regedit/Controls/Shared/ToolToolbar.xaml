<UserControl
    x:Class="JPSoftworks.Regedit.Controls.Shared.ToolToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="Surface"
        Padding="4"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="1"
        ColumnSpacing="0"
        CornerRadius="{ThemeResource ControlCornerRadius}"
        SizeChanged="Surface_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ContentPresenter
            x:Name="Commands"
            Grid.Column="1"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Stretch"
            Content="{x:Bind CommandsContent, Mode=OneWay}" />
        <ContentPresenter
            x:Name="UtilitiesHost"
            Grid.Column="2"
            VerticalAlignment="Center">
            <StackPanel
                x:Name="Utilities"
                Orientation="Horizontal"
                Spacing="8">
                <Grid
                    x:Name="SearchPanel"
                    Width="240"
                    VerticalAlignment="Center">
                    <Grid.Resources>
                        <ResourceDictionary Source="/Resources/ToolbarSearchResources.xaml" />
                    </Grid.Resources>
                    <TextBox
                        x:Name="Input"
                        Padding="32,5,12,5"
                        AutomationProperties.AutomationId="ToolSearch"
                        AutomationProperties.Name="{x:Bind SearchName, Mode=OneWay}"
                        PlaceholderText="{x:Bind SearchPlaceholder, Mode=OneWay}"
                        Text="{x:Bind SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="Input_TextChanged" />
                    <FontIcon
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE71C;"
                        IsHitTestVisible="False" />
                </Grid>
                <ContentPresenter
                    x:Name="Filters"
                    VerticalAlignment="Center"
                    Content="{x:Bind FiltersContent, Mode=OneWay}"
                    Visibility="{x:Bind FilterVisibility(FiltersContent), Mode=OneWay}" />
                <DropDownButton
                    x:Name="ViewButton"
                    MinHeight="32"
                    Padding="8,5"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ToolListViewOptions"
                    AutomationProperties.Name="List presentation: Columns"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Columns">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            x:Name="ViewIcon"
                            FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                            FontSize="16"
                            Glyph="&#xF0764;"
                            IsTextScaleFactorEnabled="False" />
                        <FontIcon
                            FontSize="8"
                            Glyph="&#xE70D;"
                            IsTextScaleFactorEnabled="False" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="ViewMenu" Placement="BottomEdgeAlignedLeft">
                            <ToggleMenuFlyoutItem
                                x:Name="ColumnsChoice"
                                Click="Columns_Click"
                                IsChecked="True"
                                Text="Columns">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xF0764;" />
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                            <ToggleMenuFlyoutItem
                                x:Name="RowsChoice"
                                Click="Rows_Click"
                                Text="Stacked rows">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular" Glyph="&#xE03E;" />
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button
                    x:Name="PreviewButton"
                    Width="36"
                    Height="32"
                    Padding="8,5"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="InspectDetails"
                    Click="Preview_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="Collapsed">
                    <FontIcon
                        x:Name="PreviewIcon"
                        FontSize="16"
                        Glyph="&#xE8A0;"
                        IsTextScaleFactorEnabled="False" />
                </Button>
            </StackPanel>
        </ContentPresenter>
    </Grid>
</UserControl>
