<UserControl
    x:Class="JPSoftworks.Regedit.Dialogs.RecentInspectionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:JPSoftworks.Regedit.Services">
    <StackPanel Style="{StaticResource DialogContentPanelStyle}">
        <TextBlock
            Text="Keep up to 100 values you explicitly inspect in the past 30 days. History is stored on this device and includes names and paths."
            TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ToggleSwitch
                x:Name="Recording"
                AutomationProperties.AutomationId="RecordInspections"
                Header="Record inspections"
                Toggled="Recording_Toggled" />
            <Button
                x:Name="ClearButton"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="ClearInspections"
                Click="Clear_Click"
                Content="Clear history" />
        </Grid>
        <TextBlock
            x:Name="StatusText"
            AutomationProperties.LiveSetting="Polite"
            TextWrapping="Wrap" />
        <ListView
            x:Name="Visits"
            MaxHeight="300"
            AutomationProperties.AutomationId="RecentInspectionList"
            AutomationProperties.Name="Recently inspected values"
            SelectionChanged="Visits_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:InspectionVisit">
                    <StackPanel Margin="0,4">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Address}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Address}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind Details}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock
            x:Name="ErrorText"
            AutomationProperties.LiveSetting="Polite"
            Style="{StaticResource DialogErrorTextStyle}"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
