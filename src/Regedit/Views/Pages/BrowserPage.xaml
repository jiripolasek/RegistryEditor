                    Height="32"
                    Margin="0,0,2,0"
                    Padding="8"
                    HorizontalAlignment="Right"
                    AccessKey="A"
                    AutomationProperties.Name="Advanced search"
                    Canvas.ZIndex="1"
                    Command="{x:Bind ViewModel.Search.FindCommand}"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Advanced search (Ctrl+Shift+F)">
                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                </Button>
