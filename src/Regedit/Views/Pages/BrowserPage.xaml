                    PlaceholderText="Search this branch"
                    QuerySubmitted="QuickSearch_Submitted"
                    Text="{x:Bind ViewModel.Search.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="QuickSearch_TextChanged">
                    <AutoSuggestBox.TextBoxStyle>
                        <Style BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}" TargetType="TextBox">
                            <Setter Property="Padding" Value="36,7,2,4" />
                        </Style>
                    </AutoSuggestBox.TextBoxStyle>
                    <AutoSuggestBox.Resources>
                        <!-- Keep the native clear button alongside the advanced search button. -->
                        <x:Double x:Key="AutoSuggestBoxRightButtonMargin">38</x:Double>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </AutoSuggestBox.Resources>
                </AutoSuggestBox>
                <Button
                    x:Name="AdvancedSearchButton"
