<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JPSoftworks.Notifications.WinUI"
    xmlns:themes="using:JPSoftworks.Notifications.WinUI.Themes">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Notifications/WinUI/Themes/NotificationResources.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <ControlTemplate x:Key="NotificationCardFluent2Template" TargetType="local:NotificationCard">
        <Grid>
            <Border
                x:Name="PART_Surface"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
                <Grid>

                    <Grid Padding="{TemplateBinding Padding}" RowSpacing="{TemplateBinding ContentSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid
                            x:Name="StatusSlot"
                            Width="16"
                            Margin="0,2,12,0"
                            VerticalAlignment="Top"
                            Visibility="{TemplateBinding StatusVisibility}">
                            <FontIcon
                                x:Name="StatusIcon"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="{ThemeResource NotificationInformationGlyph}"
                                Visibility="{TemplateBinding SeverityIconVisibility}" />
                            <Viewbox
                                Width="16"
                                Height="16"
                                IsHitTestVisible="False"
                                Visibility="{TemplateBinding CustomIconVisibility}">
                                <ContentPresenter
                                    x:Name="PART_CustomIcon"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Foreground="{TemplateBinding IconForeground}" />
                            </Viewbox>
                        </Grid>
                        <ProgressRing
                            x:Name="BusyRing"
                            Width="16"
                            Height="16"
                            Margin="0,2,12,0"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="{TemplateBinding BusyText}"
                            Foreground="{ThemeResource NotificationSecondaryForegroundBrush}"
                            IsActive="{TemplateBinding IsIndeterminate}"
                            Visibility="{TemplateBinding BusyVisibility}" />
                        <TextBlock
                            x:Name="TitleText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="SemiBold"
                            Text="{TemplateBinding Title}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="PART_CloseButton"
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="{TemplateBinding DismissNotificationText}"
                            Style="{StaticResource NotificationDismissButtonStyle}"
                            ToolTipService.ToolTip="{TemplateBinding DismissLabel}"
                            Visibility="{TemplateBinding DismissIconVisibility}">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Glyph="&#xE711;" />
                        </Button>
                        <StackPanel
                            x:Name="DetailsPanel"
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Spacing="{TemplateBinding DetailSpacing}"
                            Visibility="{TemplateBinding DetailsVisibility}">
                            <TextBlock
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{ThemeResource NotificationSecondaryForegroundBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{TemplateBinding Message}"
                                TextWrapping="Wrap"
                                Visibility="{TemplateBinding BodyVisibility}" />
                            <ProgressBar
                                Height="2"
                                AutomationProperties.Name="{TemplateBinding ProgressText}"
                                Foreground="{ThemeResource NotificationNeutralIconBrush}"
                                Maximum="1"
                                Minimum="0"
                                Visibility="{TemplateBinding DeterminateProgressVisibility}"
                                Value="{TemplateBinding ProgressValue}" />
                            <TextBlock
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{ThemeResource NotificationSecondaryForegroundBrush}"
                                Text="{TemplateBinding ProgressLabel}"
                                TextWrapping="Wrap"
                                Visibility="{TemplateBinding ProgressLabelVisibility}" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="{TemplateBinding ActionSpacing}"
                                Visibility="{TemplateBinding ActionsVisibility}">
                                <ContentPresenter x:Name="PART_ActionsPresenter" Visibility="{TemplateBinding ActionItemsVisibility}" />
                                <HyperlinkButton
                                    x:Name="PART_DismissAction"
                                    HorizontalAlignment="Left"
                                    Content="{TemplateBinding DismissLabel}"
                                    Style="{TemplateBinding ActionLinkStyle}"
                                    Visibility="{TemplateBinding DismissLinkVisibility}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="Materials">
                    <VisualState x:Name="Solid" />
                    <VisualState x:Name="Acrylic">
                        <VisualState.Setters>
                            <Setter Target="PART_Surface.Background" Value="{ThemeResource NotificationAcrylicBackgroundBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="Severities">
                    <VisualState x:Name="SeverityNeutral" />
                    <VisualState x:Name="SeverityInformation">
                        <VisualState.Setters>
                            <Setter Target="StatusIcon.Glyph" Value="{ThemeResource NotificationInformationGlyph}" />
                            <Setter Target="StatusIcon.Foreground" Value="{ThemeResource NotificationNeutralIconBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SeveritySuccess">
                        <VisualState.Setters>
                            <Setter Target="StatusIcon.Glyph" Value="{ThemeResource NotificationSuccessGlyph}" />
                            <Setter Target="StatusIcon.Foreground" Value="{ThemeResource NotificationSuccessIconBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SeverityWarning">
                        <VisualState.Setters>
                            <Setter Target="StatusIcon.Glyph" Value="{ThemeResource NotificationWarningGlyph}" />
                            <Setter Target="StatusIcon.Foreground" Value="{ThemeResource NotificationWarningIconBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SeverityError">
                        <VisualState.Setters>
                            <Setter Target="StatusIcon.Glyph" Value="{ThemeResource NotificationErrorGlyph}" />
                            <Setter Target="StatusIcon.Foreground" Value="{ThemeResource NotificationErrorIconBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>
