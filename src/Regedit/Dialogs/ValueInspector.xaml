<UserControl
    x:Class="JPSoftworks.Regedit.Dialogs.ValueInspector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:JPSoftworks.Regedit.Resources"
    xmlns:shared="using:JPSoftworks.Regedit.Controls.Shared"
    SizeChanged="Inspector_SizeChanged">
    <UserControl.Resources>
        <!--  Keep captions in the UI font and readouts monospaced.  -->
        <DataTemplate x:Key="UiFontHeaderTemplate">
            <TextBlock
                FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{Binding}" />
        </DataTemplate>
        <Style x:Key="Readout" TargetType="TextBox">
            <Setter Property="HeaderTemplate" Value="{StaticResource UiFontHeaderTemplate}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxHeight" Value="100" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="CopyReadoutButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,20,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style x:Key="ByteRangeInput" TargetType="NumberBox">
            <Setter Property="HeaderTemplate" Value="{StaticResource UiFontHeaderTemplate}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="SpinButtonPlacementMode" Value="Compact" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="16">
        <Grid
            Background="Transparent"
            ColumnSpacing="12"
            RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid HorizontalAlignment="Left">
                <FontIcon
                    FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    FontSize="32"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    Visibility="{x:Bind ViewModel.HasParentIcon}" />
                <FontIcon
                    FontSize="32"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    Style="{ThemeResource RegistryNavigationIconStyle}"
                    Visibility="{x:Bind ViewModel.HasKeyIcon}" />
                <FontIcon
                    FontFamily="{x:Bind ViewModel.IconFontFamily}"
                    FontSize="32"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    Style="{ThemeResource RegistryStringIconStyle}"
                    Visibility="{x:Bind ViewModel.HasStringIcon}" />
                <FontIcon
                    FontSize="32"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    Style="{ThemeResource RegistryLinkIconStyle}"
                    Visibility="{x:Bind ViewModel.HasLinkIcon}" />
                <Viewbox
                    Width="32"
                    Height="32"
                    Stretch="Uniform"
                    Visibility="{x:Bind ViewModel.HasBinaryIcon}">
                    <IconSourceElement
                        Width="16"
                        Height="16"
                        IconSource="{x:Bind resources:ToolRowResources.BinaryIcon}"
                        Style="{ThemeResource RegistryDataIconStyle}" />
                </Viewbox>
                <FontIcon
                    FontFamily="{x:Bind ViewModel.IconFontFamily}"
                    FontSize="32"
                    Glyph="{x:Bind ViewModel.Glyph}"
                    Style="{ThemeResource RegistryDataIconStyle}"
                    Visibility="{x:Bind ViewModel.HasDataIcon}" />
            </Grid>
            <StackPanel Grid.Row="1" Spacing="4">
                <TextBox
                    x:Name="ValueNameHeading"
                    AutomationProperties.Name="{x:Bind ViewModel.NameLabel}"
                    FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HeaderTemplate="{x:Null}"
                    Style="{StaticResource Readout}"
                    Text="{x:Bind ViewModel.Name}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Heading}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Width="30"
                    Height="30"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="6"
                    AutomationProperties.AutomationId="InspectorKeyNote"
                    AutomationProperties.Name="Open key note"
                    Command="{x:Bind OpenNoteCommand}"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Open note for this key"
                    Visibility="{x:Bind Note.HasContent, Mode=OneWay, FallbackValue=Collapsed}">
                    <FontIcon
                        FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                        FontSize="14"
                        Glyph="&#xF56D;" />
                </Button>
                <Button
                    Margin="0"
                    AutomationProperties.Name="{x:Bind ViewModel.CopyNameLabel}"
                    Click="CopyReadout_Click"
                    Loaded="CopyReadout_Loaded"
                    Style="{StaticResource CopyReadoutButton}"
                    Tag="{x:Bind ViewModel.Name}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.CopyNameLabel}">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                </Button>
            </StackPanel>
        </Grid>
        <Grid
            Background="Transparent"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.HasKeyPath}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                AutomationProperties.AutomationId="InspectorKeyPath"
                Header="Key path"
                Style="{StaticResource Readout}"
                Text="{x:Bind ViewModel.KeyPath}" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="Copy key path"
                Click="CopyReadout_Click"
                Loaded="CopyReadout_Loaded"
                Style="{StaticResource CopyReadoutButton}"
                Tag="{x:Bind ViewModel.KeyPath}"
                ToolTipService.ToolTip="Copy key path">
                <FontIcon FontSize="14" Glyph="&#xE62F;" />
            </Button>
        </Grid>
        <TextBox
            AutomationProperties.AutomationId="InspectorLastWriteTime"
            AutomationProperties.HelpText="{x:Bind ViewModel.LastWriteHelp}"
            Header="Key last modified"
            Style="{StaticResource Readout}"
            Text="{x:Bind ViewModel.LastWriteText}"
            ToolTipService.ToolTip="{x:Bind ViewModel.LastWriteHelp}"
            Visibility="{x:Bind ViewModel.HasLastWriteTime}" />
        <Button
            AutomationProperties.AutomationId="InspectorRevealFile"
            Command="{x:Bind ViewModel.RevealFileCommand}"
            Content="Reveal in File Explorer"
            Visibility="{x:Bind ViewModel.CanRevealFile}" />
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsLink}">
            <TextBox
                AutomationProperties.AutomationId="InspectorLinkTarget"
                Header="Link target"
                Style="{StaticResource Readout}"
                Text="{x:Bind ViewModel.LinkTargetPath}" />
            <TextBlock
                AutomationProperties.AutomationId="InspectorTargetStatus"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.TargetStatus, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="InspectorOpenTarget"
                Click="OpenTarget_Click"
                Command="{x:Bind ViewModel.OpenTargetCommand}"
                Content="Open target"
                Visibility="{x:Bind ViewModel.CanOpenTarget}" />
        </StackPanel>
        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasNumber}">
            <Grid Background="Transparent" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Header="Decimal (unsigned)"
                    Style="{StaticResource Readout}"
                    Text="{x:Bind ViewModel.Number.Decimal}" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Copy decimal (unsigned)"
                    Click="CopyReadout_Click"
                    Loaded="CopyReadout_Loaded"
                    Style="{StaticResource CopyReadoutButton}"
                    Tag="{x:Bind ViewModel.Number.Decimal}"
                    ToolTipService.ToolTip="Copy decimal (unsigned)">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                </Button>
            </Grid>
            <Grid Background="Transparent" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Header="Hexadecimal"
                    Style="{StaticResource Readout}"
                    Text="{x:Bind ViewModel.Number.Hexadecimal}" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Copy hexadecimal"
                    Click="CopyReadout_Click"
                    Loaded="CopyReadout_Loaded"
                    Style="{StaticResource CopyReadoutButton}"
                    Tag="{x:Bind ViewModel.Number.Hexadecimal}"
                    ToolTipService.ToolTip="Copy hexadecimal">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                </Button>
            </Grid>
            <Grid Background="Transparent" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Header="Bits (most significant first)"
                    Style="{StaticResource Readout}"
                    Text="{x:Bind ViewModel.Number.Bits}" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Copy bits (most significant first)"
                    Click="CopyReadout_Click"
                    Loaded="CopyReadout_Loaded"
                    Style="{StaticResource CopyReadoutButton}"
                    Tag="{x:Bind ViewModel.Number.Bits}"
                    ToolTipService.ToolTip="Copy bits (most significant first)">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                </Button>
            </Grid>
        </StackPanel>
        <Grid
            Background="Transparent"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.HasText}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="FullValueData"
                Header="{x:Bind ViewModel.DataLabel}"
                Style="{StaticResource Readout}"
                Text="{x:Bind ViewModel.Data}" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="Copy value data (full contents)"
                Click="CopyReadout_Click"
                Loaded="CopyReadout_Loaded"
                Style="{StaticResource CopyReadoutButton}"
                Tag="{x:Bind ViewModel.Data}"
                ToolTipService.ToolTip="Copy value data (full contents)">
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
            </Button>
        </Grid>
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasStoredValue}">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Raw bytes" />
            <Button
                x:Name="OpenRawBytes"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="OpenRawBytes"
                Click="OpenRawBytes_Click"
                Content="Open larger view"
                ToolTipService.ToolTip="Open all raw-byte columns in a larger view"
                Visibility="Collapsed" />
            <Border x:Name="RawBytesFrame" Style="{StaticResource HexViewFrameStyle}">
                <ScrollViewer
                    AutomationProperties.Name="Scroll raw byte columns"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <shared:HexView
                        x:Name="RawBytesView"
                        Height="220"
                        AutomationProperties.AutomationId="ValueHexView"
                        AutomationProperties.Name="Raw bytes"
                        Bytes="{x:Bind ViewModel.Bytes}" />
                </ScrollViewer>
            </Border>
        </StackPanel>
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasStoredValue}">
            <Button
                x:Name="InterpretBytesToggle"
                MinWidth="0"
                MinHeight="32"
                Padding="0"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="ToggleByteInterpretation"
                AutomationProperties.Name="Show byte interpretation"
                Background="Transparent"
                BorderThickness="0"
                Click="ToggleByteInterpretation_Click"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        x:Name="InterpretationChevron"
                        FontSize="10"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE76C;" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Interpret bytes" />
                </StackPanel>
            </Button>
            <StackPanel
                x:Name="InterpretationControls"
                Spacing="12"
                Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        AutomationProperties.AutomationId="InspectorByteOffset"
                        AutomationProperties.Name="Byte offset (zero based)"
                        Header="Offset (0-based)"
                        Maximum="{x:Bind ViewModel.MaximumOffset}"
                        Minimum="0"
                        Style="{StaticResource ByteRangeInput}"
                        Value="{x:Bind ViewModel.Offset, Mode=TwoWay}" />
                    <NumberBox
                        Grid.Column="1"
                        AutomationProperties.AutomationId="InspectorByteCount"
                        AutomationProperties.Name="Byte count"
                        Header="Byte count"
                        Maximum="{x:Bind ViewModel.MaximumLength}"
                        Minimum="0"
                        Style="{StaticResource ByteRangeInput}"
                        Value="{x:Bind ViewModel.Length, Mode=TwoWay}" />
                </Grid>
                <ComboBox
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="InspectorByteFormat"
                    FontSize="13"
                    Header="Interpret selected bytes as"
                    HeaderTemplate="{StaticResource UiFontHeaderTemplate}"
                    SelectedIndex="{x:Bind ViewModel.FormatIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Hexadecimal" />
                    <ComboBoxItem Content="UTF-8 (strict)" />
                    <ComboBoxItem Content="UTF-16 little-endian (strict)" />
                    <ComboBoxItem Content="UTF-16 big-endian (strict)" />
                    <ComboBoxItem Content="ASCII (strict)" />
                    <ComboBoxItem Content="Windows GUID (mixed-endian)" />
                    <ComboBoxItem Content="RFC 4122 GUID (network order)" />
                    <ComboBoxItem Content="Unix seconds (signed 64-bit, little-endian)" />
                    <ComboBoxItem Content="Unix milliseconds (signed 64-bit, little-endian)" />
                    <ComboBoxItem Content="Windows FILETIME (64-bit, little-endian)" />
                </ComboBox>
                <Button
                    Padding="12,6"
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="InterpretBytes"
                    Command="{x:Bind ViewModel.InterpretCommand}"
                    Content="Interpret"
                    FontSize="13"
                    Style="{StaticResource SubtleButtonStyle}" />
                <Grid Background="Transparent" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        AutomationProperties.AutomationId="InspectorInterpretation"
                        AutomationProperties.LiveSetting="Polite"
                        Header="Interpretation"
                        Style="{StaticResource Readout}"
                        Text="{x:Bind ViewModel.Result, Mode=OneWay}" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Copy interpretation"
                        Click="CopyReadout_Click"
                        Loaded="CopyReadout_Loaded"
                        Style="{StaticResource CopyReadoutButton}"
                        Tag="{x:Bind ViewModel.Result, Mode=OneWay}"
                        ToolTipService.ToolTip="Copy interpretation">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
