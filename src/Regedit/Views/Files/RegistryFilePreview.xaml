<UserControl
    x:Class="JPSoftworks.Regedit.Views.Files.RegistryFilePreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editor="using:WinUIEditor"
    xmlns:files="using:JPSoftworks.Regedit.Models.Files"
    xmlns:import="using:JPSoftworks.Regedit.Core.Import"
    xmlns:lists="using:JPSoftworks.Regedit.Controls.Lists"
    xmlns:resources="using:JPSoftworks.Regedit.Resources"
    xmlns:shared="using:JPSoftworks.Regedit.Controls.Shared"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FileDeletedBrush" Color="#800000" />
                    <SolidColorBrush x:Key="FileRecreatedBrush" Color="#8A4B00" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="FileDeletedBrush" Color="#FFB3BD" />
                    <SolidColorBrush x:Key="FileRecreatedBrush" Color="#F6C177" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="FileDeletedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="FileRecreatedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <DataTemplate x:Key="DiagnosticTemplate" x:DataType="import:RegistryFileDiagnostic">
                <Grid Padding="4,4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Top"
                        FontSize="14"
                        Foreground="{ThemeResource InfoBarErrorSeverityIconBackground}"
                        Glyph="{StaticResource InfoBarErrorIconGlyph}" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ToString()}"
                        TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="FileKeyTemplate" x:DataType="files:RegistryFilePreviewKey">
                <Grid
                    AutomationProperties.Name="{x:Bind Label}"
                    ColumnSpacing="8"
                    ToolTipService.ToolTip="{x:Bind Help}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        FontSize="16"
                        Glyph="&#xE8B7;"
                        Style="{ThemeResource RegistryNavigationIconStyle}"
                        Visibility="{x:Bind IsNormal}" />
                    <FontIcon
                        FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                        FontSize="16"
                        Foreground="{ThemeResource FileDeletedBrush}"
                        Glyph="&#xE65B;"
                        Visibility="{x:Bind IsDeleted}" />
                    <FontIcon
                        FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                        FontSize="16"
                        Foreground="{ThemeResource FileRecreatedBrush}"
                        Glyph="&#xE65B;"
                        Visibility="{x:Bind IsRecreated}" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind Label}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind IsNormal}" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource FileDeletedBrush}"
                        Text="{x:Bind Label}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind IsDeleted}" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource FileRecreatedBrush}"
                        Text="{x:Bind Label}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind IsRecreated}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="FileNameCell" x:DataType="files:RegistryFilePreviewRow">
                <Grid
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind AccessibleName}"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <FontIcon
                            FontFamily="{x:Bind DeletionFontFamily}"
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="{x:Bind Glyph}"
                            Visibility="{x:Bind IsDeletion}" />
                        <FontIcon
                            FontSize="16"
                            Glyph="{x:Bind Entry.Glyph}"
                            Style="{ThemeResource RegistryNavigationIconStyle}"
                            Visibility="{x:Bind HasNavigationIcon}" />
                        <FontIcon
                            FontFamily="{x:Bind Entry.IconFontFamily}"
                            FontSize="16"
                            Glyph="{x:Bind Entry.Glyph}"
                            Style="{ThemeResource RegistryStringIconStyle}"
                            Visibility="{x:Bind HasStringIcon}" />
                        <FontIcon
                            FontSize="16"
                            Glyph="{x:Bind Entry.Glyph}"
                            Style="{ThemeResource RegistryLinkIconStyle}"
                            Visibility="{x:Bind HasLinkIcon}" />
                        <IconSourceElement
                            Width="16"
                            Height="16"
                            IconSource="{x:Bind resources:ToolRowResources.BinaryIcon, Mode=OneTime}"
                            Style="{ThemeResource RegistryDataIconStyle}"
                            Visibility="{x:Bind HasBinaryIcon}" />
                        <FontIcon
                            FontFamily="{x:Bind Entry.IconFontFamily}"
                            FontSize="16"
                            Glyph="{x:Bind Entry.Glyph}"
                            Style="{ThemeResource RegistryDataIconStyle}"
                            Visibility="{x:Bind HasDataIcon}" />
                    </Grid>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind Name}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="FileCompactRow" x:DataType="files:RegistryFilePreviewRow">
                <StackPanel
                    Padding="0,5"
                    AutomationProperties.Name="{x:Bind AccessibleName}"
                    Spacing="3">
                    <ContentPresenter Content="{x:Bind}" ContentTemplate="{StaticResource FileNameCell}" />
                    <TextBlock
                        Margin="28,0,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Summary}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        ToolTipService.ToolTip="{x:Bind AccessibleName}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid KeyboardAcceleratorPlacementMode="Hidden" PreviewKeyDown="Preview_KeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="O"
                Invoked="Shortcut_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="S"
                Invoked="Shortcut_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="S"
                Invoked="Shortcut_Invoked"
                Modifiers="Control, Shift" />
            <KeyboardAccelerator
                Key="Z"
                Invoked="Shortcut_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Z"
                Invoked="Shortcut_Invoked"
                Modifiers="Control, Shift" />
            <KeyboardAccelerator
                Key="Y"
                Invoked="Shortcut_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="{x:Bind CommaKey}"
                Invoked="Shortcut_Invoked"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="W"
                Invoked="Shortcut_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="6,4">
            <shared:ListCommandBar
                x:Name="Commands"
                Height="36"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarButton
                    x:Name="FileButton"
                    AccessKey="F"
                    AutomationProperties.AutomationId="RegFileMenu"
                    IsAccessKeyScope="True"
                    Label="File"
                    ToolTipService.ToolTip="File commands">
                    <AppBarButton.Resources>
                        <Visibility x:Key="AppBarButtonHasFlyoutChevronVisibility">Visible</Visibility>
                        <x:String x:Key="AppBarButtonFlyoutGlyph">&#xE70D;</x:String>
                        <x:Double x:Key="AppBarButtonSubItemChevronFontSize">10</x:Double>
                    </AppBarButton.Resources>
                    <AppBarButton.Icon>
                        <shared:CommandIcon Symbol="Document" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem
                                x:Name="OpenButton"
                                AccessKey="O"
                                AutomationProperties.AutomationId="RegFileOpen"
                                Click="Command_Click"
                                Command="{x:Bind ViewModel.OpenCommand}"
                                KeyboardAcceleratorTextOverride="Ctrl+O"
                                Text="Open…">
                                <MenuFlyoutItem.Icon>
                                    <shared:CommandIcon Symbol="OpenFile" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                AccessKey="R"
                                AutomationProperties.AutomationId="RegFileReload"
                                Click="Command_Click"
                                Command="{x:Bind ViewModel.ReloadCommand}"
                                Text="Reload">
                                <MenuFlyoutItem.Icon>
                                    <shared:CommandIcon Symbol="Refresh" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="SaveButton"
                                AccessKey="S"
                                AutomationProperties.AutomationId="RegFileSave"
                                Click="Command_Click"
                                Command="{x:Bind ViewModel.SaveCommand}"
                                KeyboardAcceleratorTextOverride="Ctrl+S"
                                Text="Save">
                                <MenuFlyoutItem.Icon>
                                    <shared:CommandIcon Symbol="Save" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                AccessKey="A"
                                AutomationProperties.AutomationId="RegFileSaveAs"
                                Click="Command_Click"
                                Command="{x:Bind ViewModel.SaveAsCommand}"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+S"
                                Text="Save as…">
                                <MenuFlyoutItem.Icon>
                                    <shared:CommandIcon Symbol="SaveLocal" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                AccessKey="T"
                                AutomationProperties.AutomationId="RegFileSettings"
                                Click="Command_Click"
                                Command="{x:Bind ViewModel.SettingsCommand}"
                                KeyboardAcceleratorTextOverride="Ctrl+,"
                                Text="Settings…">
                                <MenuFlyoutItem.Icon>
                                    <shared:CommandIcon Symbol="Setting" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                AccessKey="C"
                                AutomationProperties.AutomationId="RegFileClose"
                                Click="Command_Click"
                                Command="{x:Bind ViewModel.CloseCommand}"
                                KeyboardAcceleratorTextOverride="Ctrl+W"
                                Text="Close">
                                <MenuFlyoutItem.Icon>
                                    <shared:CommandIcon Symbol="Cancel" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton
                    x:Name="UndoButton"
                    AccessKey="Z"
                    AutomationProperties.AutomationId="RegFileUndo"
                    Click="Command_Click"
                    Command="{x:Bind ViewModel.UndoCommand}"
                    Label="Undo"
                    ToolTipService.ToolTip="Undo source edit (Ctrl+Z)">
                    <AppBarButton.Icon>
                        <shared:CommandIcon Symbol="Undo" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Name="RedoButton"
                    AccessKey="Y"
                    AutomationProperties.AutomationId="RegFileRedo"
                    Click="Command_Click"
                    Command="{x:Bind ViewModel.RedoCommand}"
                    Label="Redo"
                    ToolTipService.ToolTip="Redo source edit (Ctrl+Y)">
                    <AppBarButton.Icon>
                        <shared:CommandIcon Symbol="Redo" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton
                    x:Name="OpenKeyButton"
                    AccessKey="K"
                    AutomationProperties.AutomationId="RegFileOpenKey"
                    Click="Command_Click"
                    Command="{x:Bind ViewModel.OpenKeyCommand}"
                    Label="Open key in registry">
                    <AppBarButton.Icon>
                        <shared:CommandIcon Symbol="Go" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <shared:ListCommandBar.TrailingContent>
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <shared:AccessibleSegmented
                            x:Name="LayoutModes"
                            Width="122"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="RegFileLayoutModes"
                            AutomationProperties.Name="View layout"
                            SelectionMode="Single">
                            <toolkit:SegmentedItem
                                x:Name="EditorOnlyMode"
                                Height="32"
                                MinWidth="40"
                                AccessKey="1"
                                AccessKeyInvoked="Layout_AccessKeyInvoked"
                                AutomationProperties.AutomationId="RegFileLayoutEditor"
                                AutomationProperties.Name="Editor only"
                                GotFocus="LayoutItem_GotFocus"
                                ToolTipService.ToolTip="Show editor only">
                                <toolkit:SegmentedItem.Icon>
                                    <SymbolIcon Symbol="AlignLeft" />
                                </toolkit:SegmentedItem.Icon>
                            </toolkit:SegmentedItem>
                            <toolkit:SegmentedItem
                                x:Name="BothMode"
                                Height="32"
                                MinWidth="40"
                                AccessKey="2"
                                AccessKeyInvoked="Layout_AccessKeyInvoked"
                                AutomationProperties.AutomationId="RegFileLayoutBoth"
                                AutomationProperties.Name="Editor and preview"
                                GotFocus="LayoutItem_GotFocus"
                                ToolTipService.ToolTip="Show editor and preview">
                                <toolkit:SegmentedItem.Icon>
                                    <SymbolIcon Symbol="TwoPage" />
                                </toolkit:SegmentedItem.Icon>
                            </toolkit:SegmentedItem>
                            <toolkit:SegmentedItem
                                x:Name="PreviewOnlyMode"
                                Height="32"
                                MinWidth="40"
                                AccessKey="3"
                                AccessKeyInvoked="Layout_AccessKeyInvoked"
                                AutomationProperties.AutomationId="RegFileLayoutPreview"
                                AutomationProperties.Name="Preview only"
                                GotFocus="LayoutItem_GotFocus"
                                ToolTipService.ToolTip="Show preview only">
                                <toolkit:SegmentedItem.Icon>
                                    <SymbolIcon Symbol="Preview" />
                                </toolkit:SegmentedItem.Icon>
                            </toolkit:SegmentedItem>
                        </shared:AccessibleSegmented>
                        <Button
                            x:Name="ImportButton"
                            Height="32"
                            Margin="8,0,2,0"
                            Padding="12,4"
                            AccessKey="I"
                            AutomationProperties.AutomationId="RegFileImport"
                            Click="Command_Click"
                            Command="{x:Bind ViewModel.ImportCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <shared:CommandIcon
                                    Width="16"
                                    Height="16"
                                    Accent="False"
                                    Symbol="Download" />
                                <TextBlock Text="Import…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </shared:ListCommandBar.TrailingContent>
            </shared:ListCommandBar>
        </Grid>
        <InfoBar
            x:Name="Notice"
            Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
            Grid.Row="1"
            Margin="8,0,8,8"
            AutomationProperties.AutomationId="RegFileNotice"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" />
        <Grid
            x:Name="Workspace"
            Grid.Row="2"
            Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="SourceColumn"
                    Width="*"
                    MinWidth="320" />
                <ColumnDefinition x:Name="SplitColumn" Width="8" />
                <ColumnDefinition
                    x:Name="PreviewColumn"
                    Width="*"
                    MinWidth="320" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="EditorPane"
                Background="{ThemeResource WorkspaceBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Source" />
                        <TextBlock
                            x:Name="FilePathDisplay"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.FilePath, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            ToolTipService.ToolTip="{x:Bind ViewModel.FilePath, Mode=OneWay}" />
                    </Grid>
                    <Grid
                        x:Name="EditorSurface"
                        Grid.Row="1"
                        Margin="0,0,1,1"
                        Background="{ThemeResource WorkspaceBackgroundBrush}">
                        <editor:CodeEditorControl
                            x:Name="SourceEditor"
                            AutomationProperties.AutomationId="RegFileSource"
                            AutomationProperties.Name="Editable registry file source"
                            HighlightingLanguage="registry" />
                    </Grid>
                    <Expander
                        Grid.Row="2"
                        MinHeight="32"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="RegFileProblems"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        IsExpanded="{x:Bind ViewModel.IsProblemsExpanded, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.HasDiagnostics, Mode=OneWay}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock FontWeight="SemiBold" Text="Problems" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.DiagnosticsSummary, Mode=OneWay}" />
                            </StackPanel>
                        </Expander.Header>
                        <ListView
                            x:Name="Problems"
                            MaxHeight="144"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="RegFileProblemsList"
                            AutomationProperties.Name="Registry file errors. Select an error to go to its source line."
                            IsEnabled="{x:Bind ViewModel.CanNavigateDiagnostics, Mode=OneWay}"
                            IsItemClickEnabled="True"
                            ItemClick="Problem_ItemClick"
                            ItemTemplate="{StaticResource DiagnosticTemplate}"
                            SelectionMode="None" />
                    </Expander>
                </Grid>
            </Border>
            <shared:ResizeThumb
                x:Name="SourceDivider"
                Grid.Column="1"
                AutomationProperties.AutomationId="RegFileSourceResize"
                AutomationProperties.Name="Resize source and preview"
                DragDelta="SourceResize_DragDelta"
                PreviewKeyDown="SourceResize_KeyDown"
                ResizeDirection="Horizontal" />
            <Grid x:Name="PreviewPane" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Expander
                    x:Name="MetadataPanel"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="RegFileMetadata"
                    Header="About this file"
                    IsExpanded="True"
                    Visibility="Collapsed">
                    <ScrollViewer
                        x:Name="MetadataContent"
                        MaxHeight="180"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <TextBlock
                                x:Name="MetadataTitle"
                                FontWeight="SemiBold"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="MetadataDescription"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="MetadataAuthor"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="MetadataFollowUp"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Notes supplied by this file." />
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
                <Border
                    Grid.Row="1"
                    Background="{ThemeResource WorkspaceBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition
                                x:Name="KeysRow"
                                Height="*"
                                MinHeight="80" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="40" />
                            <RowDefinition
                                x:Name="ValuesRow"
                                Height="*"
                                MinHeight="80" />
                        </Grid.RowDefinitions>
                        <Grid Padding="12,0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="RegFileKeysHeading"
                                AutomationProperties.HeadingLevel="Level2"
                                FontWeight="SemiBold"
                                Text="Keys" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Read-only preview" />
                        </Grid>
                        <TreeView
                            x:Name="Keys"
                            Grid.Row="1"
                            Margin="0,0,0,8"
                            AllowDrop="False"
                            AutomationProperties.AutomationId="RegFileKeys"
                            AutomationProperties.Name="Registry keys in the file"
                            CanDragItems="False"
                            CanReorderItems="False"
                            SelectionChanged="Keys_SelectionChanged"
                            SelectionMode="Single">
                            <TreeView.ItemTemplate>
                                <DataTemplate x:DataType="TreeViewNode">
                                    <ContentPresenter Content="{x:Bind Content, Mode=OneWay}" ContentTemplate="{StaticResource FileKeyTemplate}" />
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <TextBlock
                            x:Name="EmptyPreview"
                            Grid.Row="1"
                            Margin="12,12,20,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Open a .reg file to preview its keys."
                            TextWrapping="Wrap" />
                        <Grid Grid.Row="2" Background="{ThemeResource WorkspaceBackgroundBrush}">
                            <Border
                                Height="1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <shared:ResizeThumb
                                AutomationProperties.AutomationId="RegFileValuesResize"
                                AutomationProperties.Name="Resize keys and values"
                                DragDelta="ValuesResize_DragDelta"
                                PreviewKeyDown="ValuesResize_KeyDown"
                                ResizeDirection="Vertical" />
                        </Grid>
                        <Grid
                            Grid.Row="3"
                            Padding="12,0"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="RegFileValuesHeading"
                                AutomationProperties.HeadingLevel="Level2"
                                FontWeight="SemiBold"
                                Text="Values" />
                            <TextBlock
                                x:Name="SelectedPath"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Select a key to see its file instructions."
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Grid>
                        <lists:ColumnListView
                            x:Name="Values"
                            Grid.Row="4"
                            Margin="0,0,0,4"
                            AutomationProperties.AutomationId="RegFileValues"
                            AutomationProperties.Name="Read-only file instructions in source order"
                            ColumnSpacing="4"
                            SelectionMode="Single"
                            ShowColumns="True" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Grid
            x:Name="StatusBar"
            Grid.Row="3"
            MinHeight="32"
            Padding="8,2"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="Status"
                Margin="8,0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="RegFileStatus"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind ViewModel.HasNoDiagnostics, Mode=OneWay}" />
            <Button
                HorizontalAlignment="Left"
                AccessKey="D"
                AutomationProperties.AutomationId="RegFileErrorCount"
                AutomationProperties.Name="{x:Bind ViewModel.DiagnosticsSummary, Mode=OneWay}"
                Click="ShowProblems_Click"
                Command="{x:Bind ViewModel.ShowProblemsCommand}"
                Style="{StaticResource StatusButtonStyle}"
                ToolTipService.ToolTip="Show file errors (Alt+D). Import is unavailable until they are fixed."
                Visibility="{x:Bind ViewModel.HasDiagnostics, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        x:Name="ErrorStatusIcon"
                        FontSize="14"
                        Foreground="{ThemeResource InfoBarErrorSeverityIconBackground}"
                        Glyph="{StaticResource InfoBarErrorIconGlyph}" />
                    <TextBlock Text="{x:Bind ViewModel.DiagnosticsSummary, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <TextBlock
                x:Name="EncodingStatus"
                Grid.Column="1"
                Margin="8,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.EncodingName, Mode=OneWay}" />
            <TextBlock
                x:Name="CaretStatus"
                Grid.Column="2"
                Margin="8,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <Button
                x:Name="TargetView"
                Grid.Column="3"
                AutomationProperties.AutomationId="RegFileTarget"
                AutomationProperties.Name="{x:Bind ViewModel.TargetViewHelp, Mode=OneWay}"
                Content="{x:Bind ViewModel.TargetViewLabel, Mode=OneWay}"
                Style="{StaticResource StatusButtonStyle}"
                ToolTipService.ToolTip="Choose the registry view for import">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <ToggleMenuFlyoutItem
                            x:Name="Registry64Choice"
                            Click="Command_Click"
                            Command="{x:Bind ViewModel.SelectRegistry64Command}"
                            IsChecked="{x:Bind ViewModel.IsRegistry64, Mode=OneWay}"
                            Text="64-bit registry" />
                        <ToggleMenuFlyoutItem
                            x:Name="Registry32Choice"
                            Click="Command_Click"
                            Command="{x:Bind ViewModel.SelectRegistry32Command}"
                            IsChecked="{x:Bind ViewModel.IsRegistry32, Mode=OneWay}"
                            Text="32-bit registry" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBlock
                Grid.Column="4"
                Margin="8,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="This computer" />
        </Grid>
    </Grid>
</UserControl>
