                                    <AppBarButton.Icon>
                                        <shared:CommandIcon Symbol="Find" />
                                    </AppBarButton.Icon>
                                    <AppBarButton.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuFlyoutItem
                                                Command="{x:Bind ViewModel.Search.FindCommand}"
                                                Icon="Find"
                                                KeyboardAcceleratorTextOverride="Ctrl+Shift+F"
                                                Text="Advanced search…" />
                                            <MenuFlyoutItem
                                                Command="{x:Bind _window.ViewModel.FindNextResultCommand}"
                                                Icon="Forward"
                                                KeyboardAcceleratorTextOverride="F3"
                                                Text="Next search result" />
                                        </MenuFlyout>
                                    </AppBarButton.Flyout>
                                </AppBarButton>
                                <AppBarButton
                                    x:Name="WatchBranchButton"
                                    Command="{x:Bind ViewModel.WatchBranchCommand}"
