<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyTitle>Registry Editor</AssemblyTitle>
    <Description>Browse, edit, and investigate the Windows registry.</Description>
    <DefineConstants Condition="'$(RegeditUiTests)' == 'true'">$(DefineConstants);REGEDIT_UI_TESTS</DefineConstants>
    <Product Condition="'$(RegeditUiTests)' == 'true'">Regedit UI test build</Product>
    <AssemblyName>regedit2</AssemblyName>
    <RootNamespace>JPSoftworks.Regedit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <CopyOutputSymbolsToPublishDirectory Condition="'$(Configuration)' == 'Release'">false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug' and '$(RegeditUiTests)' != 'true'">
    <Compile Remove="Notifications\Prototype\**\*.cs" />
    <Page Remove="Notifications\Prototype\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI libraries reference the metapackage; suppress its unused component assets. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="BetterHexViewer.WinUI3" />
    <PackageReference Include="WinUIEdit" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <ProjectReference Include="..\Regedit.Core\Regedit.Core.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(RegeditExperimentalTerminal)' == 'true'">
    <DefineConstants>$(DefineConstants);REGEDIT_EXPERIMENTAL_TERMINAL</DefineConstants>
    <DefineConstants Condition="'$(RegeditUseSystemConPty)' == 'true'">$(DefineConstants);REGEDIT_SYSTEM_CONPTY</DefineConstants>
    <TerminalPackageVersion>1.0.20-beta.1</TerminalPackageVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(RegeditExperimentalTerminal)' == 'true'">
    <PackageDownload Include="CI.Microsoft.Terminal.WinUI3.Unofficial" Version="[$(TerminalPackageVersion)]" />
    <ProjectReference Include="..\..\third_party\Microsoft.Terminal.WinUI3\Microsoft.Terminal.WinUI3.csproj" />
    <None Include="$(NuGetPackageRoot)\ci.microsoft.terminal.winui3.unofficial\$(TerminalPackageVersion)\runtimes\$(RuntimeIdentifier)\native\Microsoft.Terminal.Control.dll"
          Link="Microsoft.Terminal.Control.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\NOTICE.Terminal.md" Link="NOTICE.Terminal.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RegeditExperimentalTerminal)' == 'true' and '$(RegeditUseSystemConPty)' != 'true'">
    <!-- Use the session assembly with our source-built WinUI host. -->
    <PackageDownload Include="EasyWindowsTerminalControl.WinUI" Version="[$(TerminalPackageVersion)]" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" />
    <Reference Include="EasyWindowsTerminalControl.WinUI" HintPath="$(NuGetPackageRoot)\easywindowsterminalcontrol.winui\$(TerminalPackageVersion)\lib\net8.0-windows10.0.19041\EasyWindowsTerminalControl.WinUI.dll" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Fonts\FluentSystemIcons-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\FluentSystemIcons-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\TitleBarIcon.png" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup Condition="'$(PublishAot)' != 'true'">
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
  </PropertyGroup>
</Project>
