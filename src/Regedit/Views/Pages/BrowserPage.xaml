                                        <shared:CommandIcon Symbol="Edit" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton
                                    x:Name="PasteButton"
                                    Command="{x:Bind ViewModel.PasteCommand, Mode=OneWay}"
                                    KeyboardAcceleratorTextOverride="Ctrl+V"
                                    Label="Paste">
                                    <AppBarButton.Icon>
                                        <shared:CommandIcon Symbol="Paste" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarSeparator />
