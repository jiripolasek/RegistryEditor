<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="JPSoftworks.Regedit.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:JPSoftworks.Regedit.Resources"
    xmlns:shared="using:JPSoftworks.Regedit.Controls.Shared">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Resources/Icons.xaml" />
                <controls:ToolRowResources />
                <!--  Other merged dictionaries here  -->
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="WorkspaceBackgroundBrush" ResourceKey="SolidBackgroundFillColorSecondaryBrush" />
                    <StaticResource x:Key="PanelBackgroundBrush" ResourceKey="LayerOnMicaBaseAltFillColorSecondaryBrush" />
                    <Style x:Key="RegistryNavigationIconStyle" TargetType="FontIcon">
                        <Setter Property="Foreground" Value="#F2C94C" />
                    </Style>
                    <Style x:Key="RegistryStringIconStyle" TargetType="FontIcon">
                        <Setter Property="Foreground" Value="#D990A0" />
                    </Style>
                    <Style x:Key="RegistryLinkIconStyle" TargetType="FontIcon">
                        <Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}" />
                    </Style>
                    <Style x:Key="RegistryDataIconStyle" TargetType="IconElement">
                        <Setter Property="Foreground" Value="#79B8FF" />
                    </Style>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#FFFFFF" />
                    <StaticResource x:Key="PanelBackgroundBrush" ResourceKey="LayerOnMicaBaseAltFillColorDefaultBrush" />
                    <Style x:Key="RegistryNavigationIconStyle" TargetType="FontIcon">
                        <Setter Property="Foreground" Value="#A67C00" />
                    </Style>
                    <Style x:Key="RegistryStringIconStyle" TargetType="FontIcon">
                        <Setter Property="Foreground" Value="#800000" />
                    </Style>
                    <Style x:Key="RegistryLinkIconStyle" TargetType="FontIcon">
                        <Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}" />
                    </Style>
                    <Style x:Key="RegistryDataIconStyle" TargetType="IconElement">
                        <Setter Property="Foreground" Value="#0067C0" />
                    </Style>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <!--  Inherit the row foreground so selected icons follow the system highlight text.  -->
                    <Style x:Key="RegistryNavigationIconStyle" TargetType="FontIcon" />
                    <Style x:Key="RegistryStringIconStyle" TargetType="FontIcon" />
                    <Style x:Key="RegistryLinkIconStyle" TargetType="FontIcon" />
                    <Style x:Key="RegistryDataIconStyle" TargetType="IconElement" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontIconSource
                x:Key="AddFavoriteIcon"
                FontFamily="ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                FontSize="20"
                Glyph="&#xF09C7;" />
            <Style
                x:Key="AppDialogStyle"
                BasedOn="{StaticResource DefaultContentDialogStyle}"
                TargetType="ContentDialog" />
            <Style x:Key="DialogContentPanelStyle" TargetType="StackPanel">
                <Setter Property="MinWidth" Value="420" />
                <Setter Property="MaxWidth" Value="480" />
                <Setter Property="Spacing" Value="16" />
            </Style>
            <!--  Frames a HexView like a text field so it reads as a bounded data area.  -->
            <Style x:Key="HexViewFrameStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="1" />
            </Style>
            <Style x:Key="DialogFieldsPanelStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="16" />
            </Style>
            <Style x:Key="DialogErrorTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CommandIconAccentStyle" TargetType="IconElement">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="PanelResizeThumbStyle" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
                x:Key="ToolbarButtonStyle"
                BasedOn="{StaticResource SubtleButtonStyle}"
                TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style
                x:Key="NavigationButton"
                BasedOn="{StaticResource ToolbarButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="36" />
            </Style>
            <Thickness x:Key="ListRowPadding">0,3</Thickness>
            <x:Double x:Key="ListRowMinHeight">28</x:Double>
            <Style
                x:Key="StatusButtonStyle"
                BasedOn="{StaticResource SubtleButtonStyle}"
                TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TabSurfaceStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource PanelBackgroundBrush}" />
            </Style>
            <Style
                x:Key="ToolPageSurfaceStyle"
                BasedOn="{StaticResource TabSurfaceStyle}"
                TargetType="Grid" />
            <Style x:Key="ToolPageHeaderStyle" TargetType="shared:ToolPageHeader">
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="OverlayToolPaneStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="ToolListSurfaceStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource WorkspaceBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="ToolInspectorStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1,0,0,0" />
                <Setter Property="Padding" Value="16,8,0,0" />
            </Style>
            <Style x:Key="ToolReadoutStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="MaxHeight" Value="240" />
            </Style>
            <Style x:Key="ToolSelectableTextStyle" TargetType="TextBlock">
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ToolListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="{ThemeResource ListRowMinHeight}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
