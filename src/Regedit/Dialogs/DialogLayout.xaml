<UserControl
    x:Class="JPSoftworks.Regedit.Dialogs.DialogLayout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DialogDefaultButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button" />
    </UserControl.Resources>
    <Grid Background="{ThemeResource ContentDialogBackground}" RowDefinitions="Auto,Auto,*,Auto">
        <TitleBar
            x:Name="CaptionBar"
            Title="Registry Editor"
            AutomationProperties.AutomationId="DialogTitleBar"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            Visibility="Collapsed">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <Thickness x:Key="TitleBarIconMargin">10,0,16,0</Thickness>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <BitmapIconSource ShowAsMonochrome="False" UriSource="ms-appx:///Assets/TitleBarIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <Border
            Grid.Row="1"
            Padding="24,8,8,16"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <Grid x:Name="HeadingPanel" Margin="0,16,16,0" ColumnDefinitions="Auto,*">
                    <SymbolIcon
                        x:Name="WarningIcon"
                        Margin="0,3,8,0"
                        VerticalAlignment="Top"
                        AutomationProperties.AccessibilityView="Raw"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Symbol="Important"
                        Visibility="Collapsed" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            x:Name="Heading"
                            AutomationProperties.AutomationId="DialogHeading"
                            AutomationProperties.HeadingLevel="Level1"
                            FontSize="20"
                            IsTextSelectionEnabled="True"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap">
                            <Run x:Name="ActionTitle" FontWeight="SemiBold" /><Run x:Name="SubjectTitle" />
                        </TextBlock>
                        <TextBlock
                            x:Name="SubtitleText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="2"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <Button
                    x:Name="HeaderCloseButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="8"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="DialogDismissButton"
                    AutomationProperties.Name="Close dialog"
                    Click="Close_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Close dialog">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>
        <ScrollViewer
            x:Name="BodyScroll"
            Grid.Row="2"
            AutomationProperties.AutomationId="DialogBody"
            Background="{ThemeResource ContentDialogTopOverlay}"
            VerticalScrollBarVisibility="Auto"
            ZoomMode="Disabled">
            <ContentPresenter
                x:Name="BodyHost"
                Margin="24,16"
                HorizontalContentAlignment="Stretch" />
        </ScrollViewer>
        <!--  Match the WinUI command area independently of the host's outer padding.  -->
        <Border
            Grid.Row="3"
            Padding="24"
            Background="{ThemeResource ContentDialogBackground}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <HyperlinkButton
                    x:Name="HelpButton"
                    AutomationProperties.AutomationId="DialogHelpButton"
                    Content="Help"
                    Visibility="Collapsed" />
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="AcceptButton"
                        MinWidth="108"
                        AutomationProperties.AutomationId="PrimaryButton"
                        Click="Accept_Click" />
                    <Button
                        x:Name="FooterCloseButton"
                        MinWidth="108"
                        AutomationProperties.AutomationId="CloseButton"
                        Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
