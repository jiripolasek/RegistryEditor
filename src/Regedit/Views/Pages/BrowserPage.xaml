                                        <shared:CommandIcon Glyph="&#xE7B3;" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton
                                    Command="{x:Bind ViewModel.OpenNotesCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsKeyLocation, Mode=OneWay}"
