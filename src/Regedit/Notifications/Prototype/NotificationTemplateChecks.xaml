<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:notifications="using:JPSoftworks.Notifications.WinUI">
    <ResourceDictionary x:Key="TranslatedNotificationStrings">
        <x:String x:Key="Dismiss">Schließen</x:String>
        <x:String x:Key="DismissNotification">Nachricht schließen</x:String>
        <x:String x:Key="DefaultAction">Standardaktion</x:String>
        <x:String x:Key="Progress">Fortschritt</x:String>
        <x:String x:Key="Busy">Vorgang läuft</x:String>
        <x:String x:Key="ExpandStack">Nachrichten aufklappen</x:String>
        <x:String x:Key="ExpandStackFormat">Alle {0} Nachrichten</x:String>
        <x:String x:Key="CollapseStackFormat">{0} Nachrichten einklappen</x:String>
        <x:String x:Key="ExpandedStackHelp">Nachrichten bleiben beim Lesen sichtbar.</x:String>
        <x:String x:Key="CollapsedStackHelp">Alle Nachrichten lesen.</x:String>
        <x:String x:Key="DismissAll">Alle schließen</x:String>
        <x:String x:Key="HistoryTitleFormat">Verlauf({0})</x:String>
        <x:String x:Key="HistoryActive">Aktiv</x:String>
        <x:String x:Key="HistoryClosed">Beendet</x:String>
        <x:String x:Key="HistoryItemFormat">{0} | {1}</x:String>
        <x:String x:Key="NotificationNameFormat">{1} ({0})</x:String>
        <x:String x:Key="ProgressFormat">{0:P0} fertig</x:String>
        <x:String x:Key="ProgressWithMessageFormat">{1:P0} fertig: {0}</x:String>
        <x:String x:Key="SeverityInformation">Hinweis</x:String>
        <x:String x:Key="SeveritySuccess">Erfolg</x:String>
        <x:String x:Key="SeverityWarning">Warnung</x:String>
        <x:String x:Key="SeverityError">Fehler</x:String>
    </ResourceDictionary>
    <DataTemplate x:Key="AlternateHistoryTemplate">
        <Grid MaxWidth="320" Tag="CustomHistory">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <HyperlinkButton x:Name="PART_HistoryDismissAll" Content="Clear custom history" />
            <ListView
                x:Name="PART_HistoryList"
                Grid.Row="1"
                MaxHeight="240"
                SelectionMode="None" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="AlternateHistoryItemTemplate">
        <Border Padding="8" Tag="CustomHistoryRow">
            <StackPanel>
                <TextBlock x:Name="PART_HistoryTitle" />
                <TextBlock x:Name="PART_HistoryMessage" />
                <StackPanel x:Name="PART_HistoryActions" Orientation="Horizontal" />
                <HyperlinkButton x:Name="PART_HistoryDismiss" Content="Close this message" />
            </StackPanel>
        </Border>
    </DataTemplate>
    <ControlTemplate x:Key="AlternateCardTemplate" TargetType="notifications:NotificationCard">
        <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="AlternateTitle" Text="{TemplateBinding Title}" />
                <TextBlock Text="{TemplateBinding Message}" />
                <ContentPresenter x:Name="PART_ActionsPresenter" />
                <HyperlinkButton x:Name="PART_DismissAction" Content="{TemplateBinding DismissLabel}" />
            </StackPanel>
        </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="AlternateHostTemplate" TargetType="notifications:NotificationHost">
        <Grid>
            <Grid.Clip>
                <RectangleGeometry x:Name="PART_HostClip" />
            </Grid.Clip>
            <Grid
                x:Name="PART_HostStack"
                MaxWidth="400"
                Margin="{TemplateBinding Padding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="PART_StackDeck">
                    <ScrollViewer x:Name="PART_CardsViewport">
                        <StackPanel x:Name="PART_CardsPanel" />
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="PART_Footer" Grid.Row="1">
                    <ToggleButton x:Name="PART_StackToggle" Content="Review notifications" />
                </Grid>
            </Grid>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="EmptyHostTemplate" TargetType="notifications:NotificationHost">
        <Grid />
    </ControlTemplate>
</ResourceDictionary>
