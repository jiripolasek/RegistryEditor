<UserControl
    x:Class="JPSoftworks.Regedit.Dialogs.NameForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Style="{StaticResource DialogFieldsPanelStyle}">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsTextSelectionEnabled="True"
            Text="{x:Bind Context}"
            TextWrapping="Wrap"
            Visibility="{x:Bind HasContext}" />
        <TextBox
            x:Name="NameInput"
            Header="{x:Bind Header}"
            PlaceholderText="{x:Bind Placeholder}"
            Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind Hint}"
            TextWrapping="Wrap"
            Visibility="{x:Bind HasHint}" />
    </StackPanel>
</UserControl>
