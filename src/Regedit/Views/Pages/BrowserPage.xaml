                                ToolTipService.ToolTip="Create a key or value (Ctrl+N)">
                                <AppBarButton.Icon>
                                    <shared:CommandIcon Symbol="Add" />
                                </AppBarButton.Icon>
                                <AppBarButton.Flyout>
                                    <MenuFlyout x:Name="NewItemMenu" Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem
                                            Command="{x:Bind ViewModel.CreateKeyCommand, Mode=OneWay}"
                                            Icon="Folder"
                                            Text="Key" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Command="{x:Bind ViewModel.CreateValueCommand, Mode=OneWay}"
                                            CommandParameter="1"
                                            Text="String value" />
                                        <MenuFlyoutItem
                                            Command="{x:Bind ViewModel.CreateValueCommand, Mode=OneWay}"
                                            CommandParameter="3"
                                            Text="Binary value" />
                                        <MenuFlyoutItem
                                            Command="{x:Bind ViewModel.CreateValueCommand, Mode=OneWay}"
                                            CommandParameter="4"
                                            Text="DWORD (32-bit) value" />
                                        <MenuFlyoutItem
                                            Command="{x:Bind ViewModel.CreateValueCommand, Mode=OneWay}"
                                            CommandParameter="11"
                                            Text="QWORD (64-bit) value" />
                                        <MenuFlyoutItem
                                            Command="{x:Bind ViewModel.CreateValueCommand, Mode=OneWay}"
                                            CommandParameter="7"
                                            Text="Multi-string value" />
                                        <MenuFlyoutItem
                                            Command="{x:Bind ViewModel.CreateValueCommand, Mode=OneWay}"
                                            CommandParameter="2"
                                            Text="Expandable string value" />
                                    </MenuFlyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton
                                x:Name="UndoButton"
                                AutomationProperties.AutomationId="UndoButton"
