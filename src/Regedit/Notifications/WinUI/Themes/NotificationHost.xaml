<ResourceDictionary
    x:Class="JPSoftworks.Notifications.WinUI.Themes.NotificationHostResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JPSoftworks.Notifications.WinUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Notifications/WinUI/Themes/NotificationCard.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="DefaultNotificationHistoryTemplate" x:DataType="local:NotificationHost">
        <StackPanel MaxWidth="400" Spacing="8">
            <Button
                x:Name="PART_HistoryDismissAll"
                AutomationProperties.AutomationId="DismissAllNotifications"
                Content="{x:Bind DismissAllText, Mode=OneWay}" />
            <ListView
                x:Name="PART_HistoryList"
                MaxHeight="360"
                AutomationProperties.AutomationId="NotificationHistoryList"
                SelectionMode="None" />
            <TextBlock x:Name="PART_HistoryOmitted" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="DefaultNotificationHistoryItemTemplate" x:DataType="local:NotificationHost">
        <StackPanel Margin="0,4,0,8" Spacing="4">
            <TextBlock x:Name="PART_HistoryTitle" TextWrapping="Wrap" />
            <TextBlock
                x:Name="PART_HistoryMessage"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
            <Button x:Name="PART_HistoryDismiss" Content="{x:Bind DismissText, Mode=OneWay}" />
            <StackPanel x:Name="PART_HistoryActions" Spacing="4" />
        </StackPanel>
    </DataTemplate>
    <Style x:Key="DefaultNotificationHostStyle" TargetType="local:NotificationHost">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="CardSpacing" Value="{ThemeResource NotificationCardSpacing}" />
        <Setter Property="HistoryTemplate" Value="{StaticResource DefaultNotificationHistoryTemplate}" />
        <Setter Property="HistoryItemTemplate" Value="{StaticResource DefaultNotificationHistoryItemTemplate}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="{ThemeResource NotificationHostPadding}" />
        <Setter Property="Background" Value="{ThemeResource NotificationBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NotificationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource NotificationCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:NotificationHost">
                    <Grid>
                        <Grid.Clip>
                            <RectangleGeometry x:Name="PART_HostClip" />
                        </Grid.Clip>
                        <Grid
                            x:Name="PART_HostStack"
                            MaxWidth="{ThemeResource NotificationMaxCardWidth}"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="PART_StackDeck">
                                <Grid IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="PART_BackplateDirection" />
                                    </Grid.RenderTransform>
                                    <Border
                                        x:Name="PART_PeekFar"
                                        Margin="16,0,16,8"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        IsHitTestVisible="False"
                                        RenderTransformOrigin="1,1"
                                        Visibility="Collapsed">
                                        <Border.RenderTransform>
                                            <CompositeTransform x:Name="FarFan" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border
                                        x:Name="PART_PeekNear"
                                        Margin="8,8,8,4"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        IsHitTestVisible="False"
                                        RenderTransformOrigin="1,1"
                                        Visibility="Collapsed">
                                        <Border.RenderTransform>
                                            <CompositeTransform x:Name="NearFan" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Grid x:Name="PART_ScrollSurface" Margin="-8">
                                    <!--  Keep room for card shadows inside the scrolling viewport.  -->
                                    <ScrollViewer
                                        x:Name="PART_CardsViewport"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.AutomationId="NotificationStackViewport"
                                        HorizontalScrollBarVisibility="Disabled"
                                        HorizontalScrollMode="Disabled"
                                        IsTabStop="False"
                                        VerticalScrollBarVisibility="Disabled"
                                        VerticalScrollMode="Disabled">
                                        <StackPanel
                                            x:Name="PART_CardsPanel"
                                            Margin="8"
                                            Spacing="{TemplateBinding CardSpacing}" />
                                    </ScrollViewer>
                                    <Rectangle x:Name="PART_ScrollFadeMask" IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop x:Name="ScrollTopFade" Offset="0" Color="White" />
                                                <GradientStop Offset="0.1" Color="White" />
                                                <GradientStop Offset="0.9" Color="White" />
                                                <GradientStop x:Name="ScrollBottomFade" Offset="1" Color="White" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                                <!--  Keep the input surface separate from the moving backplates.  -->
                                <Button
                                    x:Name="PART_PeekExpand"
                                    Height="16"
                                    MinWidth="0"
                                    MinHeight="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    AllowFocusOnInteraction="False"
                                    AutomationProperties.AccessibilityView="Raw"
                                    AutomationProperties.AutomationId="NotificationStackPeek"
                                    AutomationProperties.Name="{TemplateBinding ExpandStackText}"
                                    IsTabStop="False"
                                    Visibility="Collapsed">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <Grid
                                x:Name="PART_Footer"
                                Grid.Row="1"
                                Visibility="Collapsed">
                                <ToggleButton
                                    x:Name="PART_StackToggle"
                                    Height="24"
                                    MinWidth="0"
                                    MinHeight="24"
                                    Padding="8,2"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="NotificationStackToggle"
                                    CornerRadius="12"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock FontSize="12" Text="{TemplateBinding CountText}" />
                                        <FontIcon
                                            x:Name="StackChevron"
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="10" />
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ScrollTopEdge">
                                <VisualState x:Name="ScrollTopClear" />
                                <VisualState x:Name="ScrollTopOverflow">
                                    <VisualState.Setters>
                                        <Setter Target="ScrollTopFade.Color" Value="{ThemeResource NotificationOverflowFadeColor}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ScrollBottomEdge">
                                <VisualState x:Name="ScrollBottomClear" />
                                <VisualState x:Name="ScrollBottomOverflow">
                                    <VisualState.Setters>
                                        <Setter Target="ScrollBottomFade.Color" Value="{ThemeResource NotificationOverflowFadeColor}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="StackMaterials">
                                <VisualState x:Name="Solid">
                                    <VisualState.Setters />
                                </VisualState>
                                <VisualState x:Name="Acrylic">
                                    <VisualState.Setters>
                                        <Setter Target="PART_PeekNear.Background" Value="{ThemeResource NotificationAcrylicBackgroundBrush}" />
                                        <Setter Target="PART_PeekFar.Background" Value="{ThemeResource NotificationAcrylicBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="StackDirection">
                                <VisualState x:Name="TopCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="StackChevron.Glyph" Value="{ThemeResource NotificationStackDownGlyph}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="TopExpanded">
                                    <VisualState.Setters>
                                        <Setter Target="StackChevron.Glyph" Value="{ThemeResource NotificationStackUpGlyph}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="BottomCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="StackChevron.Glyph" Value="{ThemeResource NotificationStackUpGlyph}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="BottomExpanded">
                                    <VisualState.Setters>
                                        <Setter Target="StackChevron.Glyph" Value="{ThemeResource NotificationStackDownGlyph}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="StackPreview">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.18">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="StackInactive" />
                                <VisualState x:Name="StackRest">
                                    <VisualState.Setters>
                                        <Setter Target="PART_StackDeck.Background" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="StackFanned">
                                    <VisualState.Setters>
                                        <Setter Target="PART_StackDeck.Background" Value="Transparent" />
                                        <Setter Target="NearFan.Rotation" Value="1.5" />
                                        <Setter Target="NearFan.TranslateX" Value="-4" />
                                        <Setter Target="NearFan.TranslateY" Value="-6" />
                                        <Setter Target="FarFan.Rotation" Value="3" />
                                        <Setter Target="FarFan.TranslateX" Value="-8" />
                                        <Setter Target="FarFan.TranslateY" Value="-12" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource DefaultNotificationHostStyle}" TargetType="local:NotificationHost" />
    <Style
        x:Key="NotificationHostFluent2Style"
        BasedOn="{StaticResource DefaultNotificationHostStyle}"
        TargetType="local:NotificationHost">
        <Setter Property="CardStyle" Value="{StaticResource NotificationCardFluent2Style}" />
    </Style>
    <Style
        x:Key="NotificationHostAccentRailStyle"
        BasedOn="{StaticResource DefaultNotificationHostStyle}"
        TargetType="local:NotificationHost">
        <Setter Property="CardStyle" Value="{StaticResource NotificationCardAccentRailStyle}" />
        <Setter Property="CornerRadius" Value="{ThemeResource NotificationRoundedCornerRadius}" />
    </Style>
    <Style
        x:Key="NotificationHostCompactStyle"
        BasedOn="{StaticResource DefaultNotificationHostStyle}"
        TargetType="local:NotificationHost">
        <Setter Property="CardStyle" Value="{StaticResource NotificationCardCompactStyle}" />
        <Setter Property="CardSpacing" Value="{ThemeResource NotificationCompactCardSpacing}" />
    </Style>
    <Style
        x:Key="NotificationHostNativeStyle"
        BasedOn="{StaticResource DefaultNotificationHostStyle}"
        TargetType="local:NotificationHost">
        <Setter Property="CardStyle" Value="{StaticResource NotificationCardNativeStyle}" />
    </Style>
    <Style
        x:Key="NotificationHostMinimalStyle"
        BasedOn="{StaticResource DefaultNotificationHostStyle}"
        TargetType="local:NotificationHost">
        <Setter Property="CardStyle" Value="{StaticResource NotificationCardMinimalStyle}" />
        <Setter Property="CardSpacing" Value="{ThemeResource NotificationCompactCardSpacing}" />
        <Setter Property="CornerRadius" Value="{ThemeResource NotificationRoundedCornerRadius}" />
    </Style>
</ResourceDictionary>
