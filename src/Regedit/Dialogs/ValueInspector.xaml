<UserControl
    x:Class="JPSoftworks.Regedit.Dialogs.ValueInspector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:JPSoftworks.Regedit.Resources">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        <Style x:Key="Readout" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxHeight" Value="100" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="ReadoutLabel" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CopyReadoutButton" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style x:Key="MetadataLabel" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MetadataValue" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="InspectorDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="NoteExcerptStyle" TargetType="TextBlock">
            <Setter Property="MaxLines" Value="6" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="NoteEditStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="NoteLinkStyle" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}" TargetType="HyperlinkButton">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="12">
        <Grid Background="Transparent" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="ValueNameHeading"
                AutomationProperties.Name="{x:Bind ViewModel.NameLabel}"
                FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                FontSize="18"
                FontWeight="SemiBold"
                Style="{StaticResource Readout}"
                Text="{x:Bind ViewModel.Name}" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="{x:Bind ViewModel.CopyNameLabel}"
                Click="CopyReadout_Click"
                Loaded="CopyReadout_Loaded"
                Style="{StaticResource CopyReadoutButton}"
                Tag="{x:Bind ViewModel.Name}"
                ToolTipService.ToolTip="{x:Bind ViewModel.CopyNameLabel}">
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
            </Button>
        </Grid>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource MetadataLabel}" Text="Type" />
            <Grid Grid.Column="1" HorizontalAlignment="Right" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="16" Height="20" VerticalAlignment="Center">
                    <FontIcon
                        FontFamily="/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                        FontSize="16"
                        Glyph="{x:Bind ViewModel.Glyph}"
                        Visibility="{x:Bind ViewModel.HasParentIcon}" />
                    <FontIcon
                        FontSize="16"
                        Glyph="{x:Bind ViewModel.Glyph}"
                        Style="{ThemeResource RegistryNavigationIconStyle}"
                        Visibility="{x:Bind ViewModel.HasKeyIcon}" />
                    <FontIcon
                        FontFamily="{x:Bind ViewModel.IconFontFamily}"
                        FontSize="16"
                        Glyph="{x:Bind ViewModel.Glyph}"
                        Style="{ThemeResource RegistryStringIconStyle}"
                        Visibility="{x:Bind ViewModel.HasStringIcon}" />
                    <FontIcon
                        FontSize="16"
                        Glyph="{x:Bind ViewModel.Glyph}"
                        Style="{ThemeResource RegistryLinkIconStyle}"
                        Visibility="{x:Bind ViewModel.HasLinkIcon}" />
                    <IconSourceElement
                        Width="16"
                        Height="16"
                        IconSource="{x:Bind resources:ToolRowResources.BinaryIcon}"
                        Style="{ThemeResource RegistryDataIconStyle}"
                        Visibility="{x:Bind ViewModel.HasBinaryIcon}" />
                    <FontIcon
                        FontFamily="{x:Bind ViewModel.IconFontFamily}"
                        FontSize="16"
                        Glyph="{x:Bind ViewModel.Glyph}"
                        Style="{ThemeResource RegistryDataIconStyle}"
                        Visibility="{x:Bind ViewModel.HasDataIcon}" />
                </Grid>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource MetadataValue}"
                    Text="{x:Bind ViewModel.TypeText}" />
            </Grid>
            <TextBlock
                Grid.Row="1"
                Margin="0,4,0,0"
                Style="{StaticResource MetadataLabel}"
                Text="Size"
                Visibility="{x:Bind ViewModel.HasStoredValue}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,4,0,0"
                Style="{StaticResource MetadataValue}"
                Text="{x:Bind ViewModel.SizeText}"
                Visibility="{x:Bind ViewModel.HasStoredValue}" />
            <TextBlock
                x:Name="KeyLastModifiedLabel"
                Grid.Row="2"
                Margin="0,4,0,0"
                Style="{StaticResource MetadataLabel}"
                Text="Key last modified"
                Visibility="{x:Bind ViewModel.HasLastWriteTime}" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,4,0,0"
                AutomationProperties.AutomationId="InspectorLastWriteTime"
                AutomationProperties.HelpText="{x:Bind ViewModel.LastWriteHelp}"
                AutomationProperties.LabeledBy="{x:Bind KeyLastModifiedLabel}"
                IsTextSelectionEnabled="True"
                Style="{StaticResource MetadataValue}"
                Text="{x:Bind ViewModel.LastWriteText}"
                ToolTipService.ToolTip="{x:Bind ViewModel.LastWriteHelp}"
                Visibility="{x:Bind ViewModel.HasLastWriteTime}" />
        </Grid>
        <Border
            Style="{StaticResource InspectorDividerStyle}"
            Visibility="{x:Bind HasDetails}" />
        <Grid
            Background="Transparent"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.HasKeyPath}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="KeyPathLabel"
                Style="{StaticResource ReadoutLabel}"
                Text="Key path" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="Copy key path"
                Click="CopyReadout_Click"
                Loaded="CopyReadout_Loaded"
                Style="{StaticResource CopyReadoutButton}"
                Tag="{x:Bind ViewModel.KeyPath}"
                ToolTipService.ToolTip="Copy key path">
                <FontIcon FontSize="14" Glyph="&#xE62F;" />
            </Button>
            <TextBox
                Grid.Row="1"
                Grid.ColumnSpan="2"
                AutomationProperties.AutomationId="InspectorKeyPath"
                AutomationProperties.LabeledBy="{x:Bind KeyPathLabel}"
                Style="{StaticResource Readout}"
                Text="{x:Bind ViewModel.KeyPath}" />
        </Grid>
        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasNumber}">
            <Grid Background="Transparent" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="DecimalLabel"
                    Style="{StaticResource ReadoutLabel}"
                    Text="Decimal (unsigned)" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Copy decimal (unsigned)"
                    Click="CopyReadout_Click"
                    Loaded="CopyReadout_Loaded"
                    Style="{StaticResource CopyReadoutButton}"
                    Tag="{x:Bind ViewModel.Number.Decimal}"
                    ToolTipService.ToolTip="Copy decimal (unsigned)">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                </Button>
                <TextBox
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    AutomationProperties.LabeledBy="{x:Bind DecimalLabel}"
                    Style="{StaticResource Readout}"
                    Text="{x:Bind ViewModel.Number.Decimal}" />
            </Grid>
            <Grid Background="Transparent" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="HexadecimalLabel"
                    Style="{StaticResource ReadoutLabel}"
                    Text="Hexadecimal" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Copy hexadecimal"
                    Click="CopyReadout_Click"
                    Loaded="CopyReadout_Loaded"
                    Style="{StaticResource CopyReadoutButton}"
                    Tag="{x:Bind ViewModel.Number.Hexadecimal}"
                    ToolTipService.ToolTip="Copy hexadecimal">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                </Button>
                <TextBox
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    AutomationProperties.LabeledBy="{x:Bind HexadecimalLabel}"
                    Style="{StaticResource Readout}"
                    Text="{x:Bind ViewModel.Number.Hexadecimal}" />
            </Grid>
            <Grid Background="Transparent" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="BitsLabel"
                    Style="{StaticResource ReadoutLabel}"
                    Text="Bits (most significant first)" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Copy bits (most significant first)"
                    Click="CopyReadout_Click"
                    Loaded="CopyReadout_Loaded"
                    Style="{StaticResource CopyReadoutButton}"
                    Tag="{x:Bind ViewModel.Number.Bits}"
                    ToolTipService.ToolTip="Copy bits (most significant first)">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                </Button>
                <TextBox
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    AutomationProperties.LabeledBy="{x:Bind BitsLabel}"
                    Style="{StaticResource Readout}"
                    Text="{x:Bind ViewModel.Number.Bits}" />
            </Grid>
        </StackPanel>
        <Grid
            Background="Transparent"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.HasDataReadout}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="ValueDataLabel"
                Style="{StaticResource ReadoutLabel}"
                Text="{x:Bind ViewModel.DataLabel}" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="{x:Bind ViewModel.CopyDataLabel}"
                Click="CopyReadout_Click"
                Loaded="CopyReadout_Loaded"
                Style="{StaticResource CopyReadoutButton}"
                Tag="{x:Bind ViewModel.DataReadout}"
                ToolTipService.ToolTip="{x:Bind ViewModel.CopyDataLabel}"
                Visibility="{x:Bind ViewModel.CanCopyData}">
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
            </Button>
            <TextBox
                x:Name="FullValueData"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                AutomationProperties.LabeledBy="{x:Bind ValueDataLabel}"
                Style="{StaticResource Readout}"
                Text="{x:Bind ViewModel.DataReadout}" />
        </Grid>
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsLink}">
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="LinkTargetLabel"
                    Style="{StaticResource ReadoutLabel}"
                    Text="Link target" />
                <TextBox
                    AutomationProperties.AutomationId="InspectorLinkTarget"
                    AutomationProperties.LabeledBy="{x:Bind LinkTargetLabel}"
                    Style="{StaticResource Readout}"
                    Text="{x:Bind ViewModel.LinkTargetPath}" />
            </StackPanel>
            <TextBlock
                AutomationProperties.AutomationId="InspectorTargetStatus"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.TargetStatus, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="InspectorOpenTarget"
                Click="OpenTarget_Click"
                Command="{x:Bind ViewModel.OpenTargetCommand}"
                Content="Open target"
                Visibility="{x:Bind ViewModel.CanOpenTarget}" />
        </StackPanel>
        <Button
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="InspectorRevealFile"
            AutomationProperties.Name="Reveal in File Explorer"
            Command="{x:Bind ViewModel.RevealFileCommand}"
            Visibility="{x:Bind ViewModel.CanRevealFile}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xE8B7;" />
                <TextBlock VerticalAlignment="Center" Text="Reveal in File Explorer" />
            </StackPanel>
        </Button>
        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasStoredValue}">
            <Button
                AutomationProperties.AutomationId="OpenRawBytes"
                AutomationProperties.Name="Open raw bytes"
                Click="OpenRawBytes_Click"
                ToolTipService.ToolTip="Open raw bytes">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <IconSourceElement
                        x:Name="RawActionIcon"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Text="Raw" />
                </StackPanel>
            </Button>
            <Button
                AutomationProperties.AutomationId="OpenByteInterpreter"
                AutomationProperties.Name="Interpret bytes"
                Click="OpenByteInterpreter_Click"
                ToolTipService.ToolTip="Interpret a range of bytes">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="&#xE8AB;" />
                    <TextBlock VerticalAlignment="Center" Text="Interpret" />
                </StackPanel>
            </Button>
        </StackPanel>
        <Border
            Style="{StaticResource InspectorDividerStyle}"
            Visibility="{x:Bind NoteSection.Visibility, Mode=OneWay}" />
        <StackPanel x:Name="NoteSection" Spacing="8" Visibility="{x:Bind Notes.IsVisible, Mode=OneWay, FallbackValue=Collapsed}">
            <StackPanel x:Name="PrimaryNote" Background="Transparent" Spacing="4" Visibility="{x:Bind Notes.HasPrimary, Mode=OneWay, FallbackValue=Collapsed}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ReadoutLabel}" Text="Value note" />
                    <Button
                        x:Name="EditNote"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="{x:Bind Notes.EditId, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Notes.EditName, Mode=OneWay}"
                        Command="{x:Bind Notes.EditPrimaryCommand}"
                        Content="{x:Bind Notes.EditLabel, Mode=OneWay}"
                        Style="{StaticResource NoteEditStyle}" />
                </Grid>
                <TextBlock x:Name="NoteExcerpt" Style="{StaticResource NoteExcerptStyle}" Text="{x:Bind Notes.ValueExcerpt, Mode=OneWay}" />
                <TextBlock
                    x:Name="NoteOrigin"
                    Style="{StaticResource ReadoutLabel}"
                    Text="{x:Bind Notes.OriginLabel, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTipService.ToolTip="{x:Bind Notes.OriginAddress, Mode=OneWay}"
                    Visibility="{x:Bind Notes.IsShared, Mode=OneWay, FallbackValue=Collapsed}" />
            </StackPanel>
            <StackPanel Spacing="2" Visibility="{x:Bind Notes.HasValueActions, Mode=OneWay, FallbackValue=Collapsed}">
                <HyperlinkButton
                    x:Name="MoreNotes"
                    Click="MoreNotes_Click"
                    Content="{x:Bind Notes.MoreLabel, Mode=OneWay}"
                    Style="{StaticResource NoteLinkStyle}"
                    Visibility="{x:Bind Notes.HasMore, Mode=OneWay, FallbackValue=Collapsed}" />
                <HyperlinkButton
                    x:Name="AddValueNote"
                    Command="{x:Bind Notes.AddValueNoteCommand}"
                    Content="Add note for this value"
                    Style="{StaticResource NoteLinkStyle}"
                    Visibility="{x:Bind Notes.CanAddValueNote, Mode=OneWay, FallbackValue=Collapsed}" />
            </StackPanel>
            <StackPanel x:Name="KeyNotePreview" Background="Transparent" Spacing="4" Visibility="{x:Bind Notes.HasKeyNote, Mode=OneWay, FallbackValue=Collapsed}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ReadoutLabel}" Text="Key note" />
                    <Button
                        x:Name="EditKeyNote"
                        Grid.Column="1"
                        AutomationProperties.Name="Edit key note"
                        Command="{x:Bind Notes.EditKeyCommand}"
                        Content="Edit"
                        Style="{StaticResource NoteEditStyle}" />
                </Grid>
                <TextBlock x:Name="KeyNoteExcerpt" Style="{StaticResource NoteExcerptStyle}" Text="{x:Bind Notes.KeyExcerpt, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
