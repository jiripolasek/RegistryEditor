                                KeyboardAcceleratorTextOverride="Ctrl+Y"
                                Label="Redo"
                                ToolTipService.ToolTip="{x:Bind ViewModel.RedoHelp, Mode=OneWay}"
                                Visibility="{x:Bind RedoButton.IsEnabled, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <shared:CommandIcon Symbol="Redo" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton
                                AccessKey="I"
                                Click="Filter_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+Alt+F"
                                Label="Filter"
                                ToolTipService.ToolTip="Filter this key (Ctrl+Alt+F)">
                                <AppBarButton.Icon>
                                    <shared:CommandIcon Symbol="Filter" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton AccessKey="V" Label="View">
                                <AppBarButton.Icon>
                                    <shared:CommandIcon Symbol="View" />
                                </AppBarButton.Icon>
                                <AppBarButton.Flyout>
                                    <MenuFlyout Opening="ViewMenu_Opening" Placement="BottomEdgeAlignedLeft">
                                        <ToggleMenuFlyoutItem
                                            x:Name="ShowKeysMenu"
                                            IsChecked="{x:Bind Preferences.ShowKeysInList, Mode=TwoWay}"
                                            Text="Show keys in list" />
                                        <ToggleMenuFlyoutItem
                                            x:Name="ShowParentKeyMenu"
                                            IsChecked="{x:Bind Preferences.ShowParentKeyInList, Mode=TwoWay}"
                                            IsEnabled="{x:Bind Preferences.ShowKeysInList, Mode=OneWay}"
                                            Text="Show parent key .." />
                                        <ToggleMenuFlyoutItem
                                            x:Name="ShowPreviewMenu"
                                            IsChecked="{x:Bind Preferences.ShowValuePreview, Mode=TwoWay}"
                                            Text="Value preview" />
                                        <MenuFlyoutItem Click="ListSpacing_Click" Text="List spacing…" />
                                        <MenuFlyoutSeparator />
                                        <ToggleMenuFlyoutItem
                                            x:Name="NavigationPaneMenu"
                                            Click="TogglePane_Click"
                                            Text="Navigation pane" />
                                        <ToggleMenuFlyoutItem IsChecked="{x:Bind Preferences.ShowListToolbar, Mode=TwoWay}" Text="List toolbar" />
                                        <ToggleMenuFlyoutItem
                                            x:Name="AutoSyncTreeMenu"
                                            IsChecked="{x:Bind Preferences.AutoSyncTree, Mode=TwoWay}"
                                            Text="Automatically sync tree" />
                                        <MenuFlyoutItem
                                            Click="SyncTree_Click"
                                            Icon="Sync"
                                            KeyboardAcceleratorTextOverride="Alt+Shift+L"
                                            Text="Sync tree to current key" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="Registry view">
                                            <ToggleMenuFlyoutItem
                                                x:Name="Registry64Menu"
                                                Command="{x:Bind ViewModel.Use64BitViewCommand}"
                                                Text="64-bit registry" />
                                            <ToggleMenuFlyoutItem
                                                x:Name="Registry32Menu"
                                                Command="{x:Bind ViewModel.Use32BitViewCommand}"
                                                Text="32-bit registry" />
                                        </MenuFlyoutSubItem>
                                    </MenuFlyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="PermissionsButton"
                                Command="{x:Bind ViewModel.Branches.PermissionsCommand}"
                                CommandParameter="{x:Bind ViewModel.Location, Mode=OneWay}"
                                Label="Permissions…"
                                ToolTipService.ToolTip="Permissions for the current key">
                                <AppBarButton.Icon>
                                    <shared:CommandIcon Symbol="Permissions" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <CommandBar.SecondaryCommands>
                                <AppBarButton
                                    x:Name="SelectionActionsButton"
                                    Flyout="{StaticResource RegistryEntryMenu}"
                                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                    Label="Selection">
