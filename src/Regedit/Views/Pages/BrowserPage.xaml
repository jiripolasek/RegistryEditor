                    Height="36"
                    MinHeight="36"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    ButtonStyle="{StaticResource NavigationButton}"
                    ToggleButtonStyle="{StaticResource ToolbarShortcutToggleStyle}"
                    Visibility="Collapsed">
